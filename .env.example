# 실제 도메인을 연결한 뒤 https://를 포함해 입력합니다.
SITE_URL=https://xn--h49a29twjdmms77a5sofgdjwa.shop

# GitHub Pages 프로젝트 주소에서만 저장소 경로를 입력합니다. 사용자 도메인은 / 를 사용합니다.
BASE_PATH=/

# 실제 개통 페이지 주소를 입력합니다.
ACTIVATION_URL=https://www.n-telecom.co.kr/ntgo/

# 도메인, 개통 URL, 콘텐츠 검수를 마친 뒤에만 true로 전환합니다.
PRODUCTION_READY=false

# /start/ outbound network-specific application URLs (use the www NTGO mirror).
# If unset or pointing off the NTGO mirror, code falls back to these direct paths.
# Verify in a real mobile browser before production promotion.
START_KT_URL=https://www.n-telecom.co.kr/ntgo/view/open/kt/face_auth.aspx
START_LG_URL=https://www.n-telecom.co.kr/ntgo/view/open/lg/face_auth.aspx
# GA4 Measurement ID; without it start_view/outbound events are not collected.
PUBLIC_GA4_MEASUREMENT_ID=

# Optional separate destinations for prepaid fallback only (not the main postpaid CTA).
START_PREPAID_KT_URL=
START_PREPAID_LG_URL=
