---
import BaseLayout from "../layouts/BaseLayout.astro";
import StartHome from "../components/StartHome.astro";
import pages from "../data/generated-pages.json";
import { buildModel } from "../lib/page-model.js";
import { activationLink } from "../lib/site-config.js";
const model=buildModel(pages.find(p=>p.path==="/"));
const targets={
  K:activationLink("home_kt",{network:"kt"}),
  L:activationLink("home_lg",{network:"lg"})
};
---
<BaseLayout
  title="앤텔레콤 알뜰폰 개통방법 | KT·LG 요금제 비교"
  description="앤텔레콤 알뜰폰 KT·LG 요금제 비교, 유심 준비, 온라인 신규가입과 개통방법을 안내합니다."
  pagePath="/"
  index="index"
  ogTitle="앤텔레콤 알뜰폰 개통방법 | KT·LG 요금제 비교"
  ogDescription="KT·LG 알뜰폰 요금제와 유심을 비교하고 온라인 셀프개통을 시작하세요."
>
  <StartHome model={model} targets={targets} variant="home"/>
</BaseLayout>
