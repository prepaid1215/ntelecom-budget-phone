---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { toPublicPath } from "../../lib/site-config.js";
const sections=[
 {name:"가입·인증",items:[
  {q:"휴대폰을 바꾸지 않고 알뜰폰에 가입할 수 있나요?",a:"현재 사용 중인 휴대폰이 신청하는 통신망과 호환된다면 그대로 이용할 수 있습니다. 이용할 유심을 준비한 뒤 신청할 수 있으며 단말기 상태에 따라 제한이 있을 수 있습니다."},
  {q:"신규가입과 번호이동은 무엇이 다른가요?",a:"신규가입은 다른 번호로 서비스를 시작하는 방법이고, 번호이동은 기존에 사용 중인 번호를 유지하면서 통신사를 변경하는 방법입니다. 번호이동은 현재 이용 통신사의 사전동의가 필요할 수 있습니다."},
  {q:"셀프개통에는 어떤 인증수단이 필요한가요?",a:"신분증과 카메라 사용이 가능한 휴대폰을 준비하세요. 신청 과정에서 안면인증과 간편인증을 진행하며, 사용할 수 있는 인증수단은 실제 화면에 표시된 안내를 따라 선택합니다."},
  {q:"본인인증을 완료하지 못하면 어떻게 하나요?",a:"입력한 고객정보와 신분증 정보를 다시 확인하세요. 카메라 권한이 꺼져 있다면 허용한 뒤 재시도하고, 진행되지 않으면 공식 신청 화면의 안내를 확인하세요."}
 ]},
 {name:"유심·개통",items:[
  {q:"KT망 개통에 사용할 유심은 무엇인가요?",a:"앤텔레콤 KT망 가입에 지원되는 KT 바로유심을 준비하세요. 다른 알뜰폰 사업자용 유심은 같은 KT망이어도 사용할 수 없을 수 있습니다."},
  {q:"KT 바로유심 번호 입력할 때 F도 쓰나요?",a:"유심 카드에 표시된 일련번호 중 숫자 19자리를 입력하며, 마지막 영문 F는 제외합니다."},
  {q:"LG 모두의 원칩 정보는 어디까지 입력하나요?",a:"LG 원칩의 모델코드 5자리와 일련번호 숫자 8자리를 확인해 화면의 입력란에 각각 적습니다."},
  {q:"개통 화면에서 신청을 마치면 유심은 언제 장착하나요?",a:"신청 화면에서 개통 완료 상태를 확인한 뒤 휴대폰에 유심을 넣고 재부팅해 주세요. 이용이 시작되지 않으면 완료 여부와 유심정보를 다시 확인하세요."}
 ]},
 {name:"요금제·월 요금",items:[
  {q:"매월 이용요금은 어떻게 납부하나요?",a:"요금제를 선택한 뒤 신청 화면에서 안내하는 월 요금 납부정보를 입력합니다. 납부일과 방법은 실제 가입 화면 및 이용 안내를 확인하세요."},
  {q:"사용량에 맞는 요금제는 어디에서 비교하나요?",a:"요금제 비교 페이지에서 데이터 제공량, 소진 후 속도, 음성·문자 이용 조건, 월 이용요금을 확인할 수 있습니다. 신청 전 제휴 혜택 조건도 함께 비교하세요."},
  {q:"요금제를 선택했는데 실제 화면의 금액이 다르면요?",a:"가입 시점과 이벤트 조건에 따라 안내 금액이 달라질 수 있습니다. 신청을 확정하기 전에 제공되는 최종 요금과 조건을 확인하세요."}
 ]}
];
const all=sections.flatMap(x=>x.items);
---
<BaseLayout title="알뜰폰 셀프개통 자주 묻는 질문 | 유심·본인인증·요금제" description="앤텔레콤 알뜰폰 가입 전 많이 묻는 질문을 주제별로 정리했습니다. 유심번호, 안면인증, 신규가입·번호이동, 월 요금 납부 안내." pagePath="/faq/" index="index" breadcrumbs={[{name:"자주 묻는 질문",path:"/faq/"}]} faqs={all}>
 <article class="fq">
  <div class="fq-wrap">
   <nav class="fq-crumb" aria-label="현재 위치"><a href={toPublicPath("/")}>홈</a><span aria-hidden="true">›</span><span>자주 묻는 질문</span></nav>
   <header class="fq-hero"><span>HELP & FAQ</span><h1>알뜰폰 자주 묻는 질문</h1><p>가입 과정에서 헷갈리는 내용을 유심, 본인인증, 요금제별로 모았습니다. 필요한 질문을 눌러 답변을 확인하세요.</p></header>
   <nav class="fq-tabs" aria-label="질문 주제 바로가기">{sections.map((section,i)=><a href={"#faq-topic-"+(i+1)}>{section.name}</a>)}</nav>
   {sections.map((section,i)=><section class="fq-section" id={"faq-topic-"+(i+1)}>
    <h2>{section.name}</h2>
    <div class="fq-questions">{section.items.map(({q,a})=><details><summary>{q}</summary><p>{a}</p></details>)}</div>
   </section>)}
   <section class="fq-bottom"><h2>개통 화면을 보면서 진행하고 싶다면</h2><p>준비한 유심에 맞는 통신망의 신청방법을 확인하세요.</p><div class="fq-actions"><a href={toPublicPath("/guide/kt/")}>KT망 개통방법</a><a href={toPublicPath("/guide/lg/")}>LG망 개통방법</a><a href={toPublicPath("/plans/")}>요금제 비교</a></div></section>
  </div>
 </article>
</BaseLayout>
<style>
.fq{background:#fff;color:#34323A;padding:35px 18px 70px}.fq-wrap{max-width:980px;margin:auto}.fq-crumb{display:flex;align-items:center;gap:10px;font-size:12px;margin-bottom:25px;color:#706977}.fq-crumb a{color:#B01760}.fq-hero{background:#FFF1F6;border-radius:22px;padding:clamp(22px,4vw,42px)}.fq-hero span{color:#C91F6D;font-size:12px;font-weight:850}.fq-hero h1{font-size:clamp(27px,4vw,40px);line-height:1.3;margin:8px 0 10px}.fq-hero p{font-size:15px;line-height:1.85;color:#645D68;margin:0}.fq-tabs{display:flex;gap:9px;flex-wrap:wrap;margin:25px 0}.fq-tabs a{background:#fff;border:1px solid #F5B7D0;color:#B2165D;text-decoration:none;border-radius:24px;padding:11px 17px;font-size:14px;font-weight:750}.fq-section{padding:20px 0 26px;scroll-margin-top:90px}.fq-section h2{font-size:25px;margin:0 0 19px}.fq-questions{display:grid;gap:11px}.fq-questions details{border:1px solid #F1DFE7;border-radius:13px;padding:18px;background:#fff}.fq-questions details[open]{background:#FFFAFC}.fq-questions summary{cursor:pointer;font-weight:800;font-size:16px}.fq-questions p{font-size:14px;line-height:1.85;color:#615B64;margin:12px 0 2px}.fq-bottom{background:#FFF1F6;border-radius:18px;padding:28px;margin-top:22px}.fq-bottom h2{font-size:23px;margin:0 0 8px}.fq-bottom p{font-size:14px;color:#645C66;margin:0;line-height:1.7}.fq-actions{display:flex;flex-wrap:wrap;gap:9px;margin-top:20px}.fq-actions a{background:#ED2675;color:#fff;text-decoration:none;font-weight:750;border-radius:10px;padding:13px 16px;font-size:14px}@media(max-width:550px){.fq{padding:22px 14px 50px}.fq-tabs a{font-size:13px}.fq-bottom{padding:20px}.fq-actions{flex-direction:column}.fq-actions a{text-align:center}}
</style>
