---
import BaseLayout from "../layouts/BaseLayout.astro";
import { siteConfig as site, toPublicPath } from "../lib/site-config.js";
---
<BaseLayout title="페이지를 찾을 수 없어요" description="주소가 바뀌었거나 없는 페이지예요. 요금제 목록에서 다시 찾아보세요." index="noindex" pagePath="/404/">
  <section class="section"><div class="wrap nf">
    <p class="nf-code">404</p>
    <h1>찾는 페이지가 없어요</h1>
    <p class="nf-lead">주소가 바뀌었거나 잘못 입력됐을 수 있어요. 아래에서 다시 찾아보세요.</p>
    <div class="link-list">
      <a href={toPublicPath("/")}><span>홈으로 가기</span><span>›</span></a>
      <a href={toPublicPath("/plans/")}><span>전체 요금제 보기</span><span>›</span></a>
      <a href={toPublicPath("/guide/")}><span>개통 방법 보기</span><span>›</span></a>
      <a href={site.business.kakao} rel="noopener"><span>카카오톡 채널로 문의하기</span><span>›</span></a>
    </div>
  </div></section>
</BaseLayout>
