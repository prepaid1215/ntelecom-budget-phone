---
import "../styles/global.css";
import "../styles/start.css";
import StartSidebar from "../components/StartSidebar.astro";
import {buildModel} from "../lib/page-model.js";
import StartHeader from "../components/StartHeader.astro";
import pagesData from "../data/generated-pages.json";
import { siteConfig as site, activationLink, toPublicPath, toSiteUrl } from "../lib/site-config.js";
const {
  title,
  ctaSource="",
  description=site.defaultDescription,
  index="index",
  faqs=[],
  pagePath=Astro.url.pathname,
  image="/images/hero-mobile.webp"
} = Astro.props;
const homeModel=buildModel(pagesData.find(p=>p.path==="/"));
const choose=(net,gb)=>homeModel.matched.filter(p=>p.network===net&&p.data_gb===gb).sort((a,b)=>a.monthly_price-b.monthly_price)[0];
const sidebarPlans=[choose("L",7),choose("K",7),choose("K",15)].filter(Boolean);
const outboundBase=site.activationUrl||"https://preplan.site/";
const sidebarTargets={K:process.env.START_KT_URL?.trim()||outboundBase,L:process.env.START_LG_URL?.trim()||outboundBase};
const fullTitle = title;
const canonical = toSiteUrl(pagePath);
const socialImage = toSiteUrl(image);
const robots = site.productionReady && index==="index" ? "index,follow" : "noindex,follow";
const websiteId = toSiteUrl("/#website");
const organizationId = toSiteUrl("/#organization");
// Breadcrumb trail = home + every existing generated page whose path is a prefix of this one.
const pageByPath = new Map(pagesData.map(p=>[p.path,p]));
const trail = [];
const segments = pagePath.replace(/^\/|\/$/g,"").split("/").filter(Boolean);
for(let i=1;i<=segments.length;i++){
  const path="/"+segments.slice(0,i).join("/")+"/";
  const hit=pageByPath.get(path);
  if(hit) trail.push({name:hit.keyword,path});
}
if(ctaSource.startsWith("exp_a_")) trail.push({name:"알뜰폰 가이드",path:"/guides/"},{name:title.split("｜")[0],path:pagePath});
if(pagePath==="/guides/") trail.push({name:"알뜰폰 가이드",path:pagePath});
const crumbs=[{name:site.brandName,path:"/"},...trail.filter(c=>c.path!=="/")];
const schemas={
  "@context":"https://schema.org",
  "@graph":[
    {
      "@type":"WebSite",
      "@id":websiteId,
      "url":toSiteUrl("/"),
      "name":site.brandName,
      "inLanguage":"ko-KR",
      "publisher":{"@id":organizationId}
    },
    {
      "@type":"Organization",
      "@id":organizationId,
      "name":site.business.name,
      "legalName":site.business.operator,
      "url":toSiteUrl("/"),
      "telephone":site.business.phone,
      "address":{"@type":"PostalAddress","streetAddress":site.business.address,"addressCountry":"KR"},
      "sameAs":[site.business.kakao]
    },
    {
      "@type":"WebPage",
      "@id":`${canonical}#webpage`,
      "url":canonical,
      "name":fullTitle,
      "description":description,
      "inLanguage":"ko-KR",
      "isPartOf":{"@id":websiteId},
      "primaryImageOfPage":{"@type":"ImageObject","url":socialImage},
      "breadcrumb":{"@id":`${canonical}#breadcrumb`}
    },
    {
      "@type":"BreadcrumbList",
      "@id":`${canonical}#breadcrumb`,
      "itemListElement":crumbs.map((c,i)=>({"@type":"ListItem","position":i+1,"name":c.name,"item":toSiteUrl(c.path)}))
    }
  ]
};
if(faqs.length) schemas["@graph"].push({
  "@type":"FAQPage",
  "@id":`${canonical}#faq`,
  "url":canonical,
  "inLanguage":"ko-KR",
  "mainEntity":faqs.map(f=>({"@type":"Question","name":f.q,"acceptedAnswer":{"@type":"Answer","text":f.a}}))
});
---
<!doctype html>
<html lang="ko-KR">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
<title>{fullTitle}</title>
<meta name="description" content={description} />
<meta name="robots" content={robots} />
<meta name="googlebot" content={robots} />
<meta name="theme-color" content={site.primaryColor} />
<>
<link rel="stylesheet" crossorigin="anonymous" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard/dist/web/static/pretendard.css" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/sun-typeface/SUIT/fonts/static/woff2/SUIT.css" />
</>
<link rel="canonical" href={canonical} />
<link rel="alternate" hreflang="ko-KR" href={canonical} />
<link rel="icon" type="image/png" href={toPublicPath("/images/start/favicon.png?v=2")} />
<meta property="og:type" content="website" />
<meta property="og:locale" content="ko_KR" />
<meta property="og:site_name" content={site.brandName} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={socialImage} />
<meta property="og:image:width" content="1000" />
<meta property="og:image:height" content="750" />
<meta property="og:image:alt" content="앤텔레콤 알뜰폰 요금제와 혜택 안내" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={socialImage} />
<script type="application/ld+json" set:html={JSON.stringify(schemas)}></script>
</head>
<body data-site-shell>
<StartHeader pagePath={pagePath} ctaSource={ctaSource}/>
<main>
  <slot />
</main>
<StartSidebar featured={sidebarPlans} targets={sidebarTargets} pagePath={pagePath} ctaSource={ctaSource}/>
<footer class="site-footer"><div class="wrap">
  <p><strong>{pagePath==="/start/" ? site.business.operator : site.business.name}</strong> · 앤텔레콤 계약 판매점</p>
  <p>{site.business.address} · 사업자등록번호 {site.business.bizNo} · 통신판매신고 {site.business.mailOrderNo}</p>

</div></footer>
<div class="bottom"><div class="bottom-inner">
  <button class="bottom-save" type="button" data-save-page>저장</button>
  <a class="bottom-go" href={pagePath==="/start/" ? "#start-choices" : activationLink(ctaSource||"bottom")}>{pagePath==="/start/" ? "통신망 선택하기" : "바로 개통하기"}</a>
</div></div>
<script is:inline>
  document.addEventListener("click",function(e){
    var el=e.target.closest("[data-save-plan],[data-save-page]");
    if(!el) return;
    try{
      if(el.hasAttribute("data-save-plan")) localStorage.setItem("savedPlan",el.getAttribute("data-save-plan"));
      else localStorage.setItem("savedPage",location.href);
    }catch(err){}
    el.textContent="저장됨";
  });
</script>
</body></html>
