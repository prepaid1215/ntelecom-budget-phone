---
import {activationLink,toPublicPath} from '../lib/site-config.js';
import {plans} from '../lib/catalog.js';
const {page}=Astro.props;
const source='exp_a_'+page.id.replaceAll('-','_');
const network=page.network;
const open=(net=network)=>activationLink(source,{network:net});
const usims=[{net:'K',name:'KT 바로유심',src:'/images/usim/baro-usim.webp',w:560,h:699,entry:'숫자 19자리 · 끝의 F 제외'},{net:'L',name:'LG 모두의 원칩',src:'/images/usim/onechip.webp',w:560,h:560,entry:'모델코드 5자리 + 일련번호 8자리'}].filter(x=>!network||x.net===network);
const guideImage=(n)=>'https://uniuni03.mycafe24.com/wp-content/uploads/2026/04/platform-rule-0'+n+'.jpg';
const candidates=[
 {purpose:'와이파이를 주로 쓴다면',detail:'이동 중 메신저·지도 이용이 중심인 분',id:'ntelecom-l-7gb'},
 {purpose:'독서 혜택도 이용한다면',detail:'밀리의서재 제휴 상품을 찾는 분',id:'ntelecom-k-7gb-millie'},
 {purpose:'밖에서 데이터 사용이 많다면',detail:'기본 데이터와 소진 후 속도를 함께 볼 분',id:'ntelecom-l-11gb-daily2gb'}
];
const suitable=candidates.map(x=>({...x,plan:plans.find(p=>p.id===x.id)})).filter(x=>x.plan&&(!network||x.plan.network===network));
if(network&&suitable.length<2){for(const plan of plans.filter(p=>p.network===network&&p.calls.startsWith('기본')).sort((a,b)=>a.monthly_price-b.monthly_price)){if(!suitable.some(x=>x.plan.data_gb===plan.data_gb)&&suitable.length<2)suitable.push({purpose:plan.data_gb+'GB 상품도 함께 보기',detail:'월요금과 소진 후 속도 비교',plan})}}
const money=n=>n.toLocaleString('ko-KR')+'원';
---
<div class="walk" data-signup-walkthrough={page.id}>
 <div class="walk-wrap">
  <nav class="walk-breadcrumb" aria-label="현재 위치"><a href={toPublicPath('/guides/')}>알뜰폰 가이드</a><span>›</span><span>신규가입</span></nav>
  <article>
   <header class="walk-intro">
    <p class="walk-kicker">앤텔레콤 후불 알뜰폰</p>
    <h1>{page.id==='signup'?'앤텔레콤 알뜰폰 신규가입,\n이 순서로 진행하세요':page.title}</h1>
    <p>{network?(network==='K'?'KT 바로유심':'LG 모두의 원칩')+'과 본인 명의 인증수단을 준비했다면 온라인으로 신청할 수 있어요.':'유심과 본인 명의 인증수단을 준비했다면 온라인으로 신청할 수 있어요.'}<br/>신청 화면에서는 <strong>신규가입 · 후불</strong>을 선택합니다.</p>
    <a class="walk-primary" href={open()}>신청 화면 열기 <span aria-hidden="true">↗</span></a>
    <a class="walk-text-link" href="#prepare">먼저 준비물 보기 ↓</a>
   </header>
   <nav class="walk-jumps" aria-label="신규가입 단계 바로가기"><a href="#prepare"><b>1</b>준비물</a><a href="#choose"><b>2</b>신청·인증</a><a href="#usim-entry"><b>3</b>유심정보</a><a href="#plan-select"><b>4</b>요금제·완료</a></nav>
   <section class="walk-section" id="prepare">
    <div class="walk-section-title"><span>01</span><h2>유심과 인증수단을 준비해 주세요</h2></div>
    <p>신청할 때는 <strong>유심 카드, 본인 명의 간편인증 수단, 요금 납부정보</strong>가 필요해요. 사용할 휴대폰도 옆에 두면 개통 후 바로 장착하기 편합니다.</p>
    <div class="walk-usims">{usims.map(x=><figure><img src={toPublicPath(x.src)} alt={x.name+' 실제 포장'} width={x.w} height={x.h} loading="lazy"/><figcaption><strong>{x.name}</strong><span>{x.net==='K'?'KT망':'LG망'}으로 신청</span></figcaption></figure>)}</div>
    <p class="walk-note">유심은 카드와 함께 준비해 두세요. 카드에 적힌 정보를 신청 중에 입력합니다.</p>
   </section>
   <section class="walk-section" id="choose">
    <div class="walk-section-title"><span>02</span><h2>신규가입과 후불을 선택하세요</h2></div>
    <p>바로유심은 <strong>KT 개통하기</strong>, 원칩은 <strong>LG 개통하기</strong>로 들어갑니다. 가입 화면에서 아래 항목을 골라주세요.</p>
    <dl class="walk-choices"><div><dt>가입 유형</dt><dd>신규가입</dd></div><div><dt>요금 방식</dt><dd>후불</dd></div></dl>
    <p>이어지는 안면인증과 간편인증은 화면에 따라 진행하세요. 간편인증에는 <strong>가입자 본인 명의의 인증수단</strong>을 사용합니다.</p>
    <details class="walk-reference"><summary>가입 유형·간편인증 화면 예시 보기</summary><div class="walk-reference-grid"><figure><a href={guideImage(2)} target="_blank" rel="noopener noreferrer" aria-label="가입 유형 화면 예시 크게 보기"><img src={guideImage(2)} width="1080" height="1080" loading="lazy" alt="공개 개통 가이드의 신규가입·고객유형 선택 화면 예시"/></a><figcaption>가입 유형에서 신규가입 선택</figcaption></figure><figure><a href={guideImage(4)} target="_blank" rel="noopener noreferrer" aria-label="간편인증 화면 예시 크게 보기"><img src={guideImage(4)} width="1080" height="1080" loading="lazy" alt="공개 개통 가이드의 본인 명의 간편인증 화면 예시"/></a><figcaption>본인 명의 인증수단으로 간편인증</figcaption></figure></div><p class="walk-note">이미지를 누르면 크게 볼 수 있어요. 59만모바일에 게시된 개통 가이드 예시입니다. 후불 선택 항목과 진행 순서는 현재 신청 화면의 안내를 따라주세요.</p></details>
   </section>
   <section class="walk-section" id="usim-entry">
    <div class="walk-section-title"><span>03</span><h2>유심 카드에 적힌 정보를 입력하세요</h2></div>
    <div class="walk-entry-grid">{usims.map(x=><div class="walk-entry"><h3>{x.name}</h3>{x.net==='K'?<><p><strong>숫자 19자리</strong>를 입력합니다.</p><p>끝에 붙은 <b>F는 빼고</b> 넣어주세요.</p></>:<><p><strong>모델코드 5자리</strong></p><p><strong>일련번호 8자리</strong>를 각각 입력해요.</p></>}</div>)}</div>
    <p>전화번호나 휴대폰 기기번호를 넣는 칸이 아니에요. 입력한 내용이 유심 카드와 같은지 한 번만 대조해 주세요.</p>
    <details class="walk-reference"><summary>유심번호 위치 사진으로 보기</summary><figure class="walk-single-image"><a href={guideImage(5)} target="_blank" rel="noopener noreferrer" aria-label="유심번호 위치 이미지 크게 보기"><img src={guideImage(5)} width="1080" height="1080" loading="lazy" alt="KT 유심번호와 LG 모델코드·일련번호 위치를 보여주는 공개 개통 가이드"/></a><figcaption>유심 카드의 번호 위치 안내</figcaption></figure></details>
   </section>
   <section class="walk-section" id="plan-select">
    <div class="walk-section-title"><span>04</span><h2>사용할 요금제와 납부정보를 등록하세요</h2></div>
    <p>아직 요금제를 정하지 않았다면 <strong>평소 쓰는 데이터와 통화량</strong>을 기준으로 골라보세요. 아래는 사용 목적별로 살펴볼 상품입니다.</p>
    <div class="walk-plans">{suitable.slice(0,3).map(({purpose,detail,plan})=><article><p class="walk-purpose">{purpose}</p><h3>{plan.name.replace(/^앤텔레콤\s*/,'')}</h3><p class="walk-plan-detail">{detail}</p><dl><div><dt>월 기본료</dt><dd>{money(plan.monthly_price)}</dd></div><div><dt>데이터</dt><dd>{plan.data_text}</dd></div><div><dt>통화</dt><dd>{plan.calls}</dd></div></dl><a href={activationLink(source,{network:plan.network,plan:plan.id,planName:plan.name})}>이 상품으로 신청 화면 열기 ↗</a></article>)}</div>
    <a class="walk-text-link" href={toPublicPath('/plans/'+(network?network.toLowerCase()+'/':''))}>전체 요금제 비교하기 →</a>
    <div class="walk-finish"><h3>신청을 마치기 전에</h3><ul><li>선택한 상품명과 월 기본료 살펴보기</li><li>전화번호 선택과 요금 납부정보 등록하기</li><li>전자서명 등 화면의 마지막 절차까지 완료하기</li></ul></div>
   </section>
   <section class="walk-after"><h2>개통 완료 안내 후 유심을 장착하세요</h2><p>본사 해피콜과 개통 진행 안내를 받아주세요. <strong>개통 완료 안내를 받으면</strong> 준비한 유심을 휴대폰에 넣고 통화와 모바일 데이터를 이용해 보면 됩니다.</p><p>후불 요금은 등록한 납부 방식으로 매월 납부합니다.</p></section>
   <section class="walk-last"><h2>유심을 준비했다면 시작해 보세요</h2><div class="walk-net-buttons">{(!network||network==='K')&&<a href={open('K')}>KT망 신규가입 ↗</a>}{(!network||network==='L')&&<a href={open('L')}>LG망 신규가입 ↗</a>}</div></section>
  </article>
 </div>
</div>
<style>
.walk{padding:30px 24px 80px;background:#fbf9fc;color:#242027}.walk-wrap{max-width:900px;margin:auto}.walk-breadcrumb{display:flex;flex-wrap:wrap;gap:10px;color:#756c78;font-size:13px;margin-bottom:20px}.walk article{background:#fff;border:1px solid #eadfe9;border-radius:20px;overflow:hidden}.walk-intro{padding:38px 42px;background:linear-gradient(125deg,#fff1f6,#faf7ff)}.walk-kicker{font-size:13px;font-weight:700;color:#a12458;margin:0 0 14px}.walk h1{white-space:pre-line;font-size:clamp(27px,3.2vw,36px);line-height:1.45;letter-spacing:-1px;margin:0 0 18px;word-break:keep-all}.walk-intro>p:not(.walk-kicker){font-size:17px;line-height:1.9;margin:0 0 24px;color:#514754}.walk-primary{display:inline-flex;gap:26px;align-items:center;padding:15px 22px;color:white;background:#b91f60;border-radius:10px;font-weight:700}.walk-text-link{display:inline-block;color:#914266;font-size:14px;margin:14px 0 0;text-decoration:underline;text-underline-offset:4px}.walk-intro .walk-text-link{margin-left:20px}.walk-jumps{display:grid;grid-template-columns:repeat(4,1fr);border-bottom:1px solid #eee5ec;padding:16px 28px;gap:10px}.walk-jumps a{display:flex;align-items:center;justify-content:center;gap:8px;min-height:40px;font-size:14px;font-weight:600}.walk-jumps b{color:#b91f60}.walk-section{padding:32px 42px;border-bottom:1px solid #eee5ec;scroll-margin-top:105px}.walk-section-title{display:flex;align-items:flex-start;gap:14px;margin-bottom:20px}.walk-section-title>span{flex:none;border-radius:8px;background:#fbe9f1;color:#ac1f58;padding:5px 8px;font-size:13px;font-weight:800;margin-top:3px}.walk h2{font-size:23px;line-height:1.5;letter-spacing:-.7px;margin:0;word-break:keep-all}.walk-section>p,.walk-after p{font-size:17px;line-height:1.9;margin:0 0 18px;word-break:keep-all;color:#4b424f}.walk-usims{display:flex;justify-content:center;flex-wrap:wrap;gap:18px;margin:22px 0}.walk-usims figure{margin:0;flex:1;max-width:260px;min-width:160px;text-align:center;border:1px solid #eee5eb;background:#faf9fb;border-radius:14px;padding:18px}.walk-usims img{width:100%;height:180px;object-fit:contain}.walk-usims figcaption{display:grid;gap:6px;font-size:15px;margin-top:12px}.walk-usims figcaption span{font-size:13px;color:#766b7a}.walk .walk-note{font-size:13px;color:#796f7b;line-height:1.75}.walk-choices{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin:22px 0}.walk-choices>div{display:flex;align-items:center;justify-content:space-between;gap:12px;background:#fff5f9;border:1px solid #f0d5e2;border-radius:12px;padding:19px}.walk-choices dt{font-size:14px;color:#75616d}.walk-choices dd{font-size:20px;font-weight:800;color:#ae1d58;margin:0}.walk-reference{border:1px solid #e9e2eb;border-radius:12px;padding:16px;margin:22px 0 0}.walk-reference summary{font-size:14px;line-height:1.6;font-weight:600;color:#68506e;cursor:pointer}.walk-reference-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin:18px 0}.walk-reference figure{margin:0;text-align:center}.walk-reference img{width:100%;height:auto;border-radius:10px}.walk-reference figcaption{font-size:13px;color:#756b79;line-height:1.6;margin-top:10px}.walk-single-image{max-width:500px;margin:18px auto 0!important}.walk-entry-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:14px;margin-bottom:20px}.walk-entry{padding:22px;background:#faf7fc;border:1px solid #eee5f0;border-radius:12px}.walk h3{font-size:17px;line-height:1.5;margin:0 0 15px}.walk-entry p{font-size:16px;line-height:1.75;margin:6px 0}.walk-plans{display:grid;gap:16px;margin-top:22px}.walk-plans article{border:1px solid #eadfe8;border-radius:12px;padding:22px}.walk-purpose{font-size:13px;color:#a01d53;font-weight:700;margin:0 0 8px}.walk-plan-detail{color:#776a7c;font-size:14px;margin:0 0 18px}.walk-plans dl{margin:0}.walk-plans dl>div{display:grid;grid-template-columns:90px 1fr;gap:12px;padding:8px 0;font-size:15px;line-height:1.6}.walk-plans dt{color:#776c7a}.walk-plans dd{margin:0}.walk-plans dl>div:first-child dd{font-size:21px;font-weight:800}.walk-plans a{display:inline-block;font-size:14px;font-weight:700;color:#a31b52;border-top:1px solid #eee2ea;padding-top:16px;margin-top:15px;width:100%}.walk-finish{padding:22px;background:#faf7fb;border-radius:12px;margin-top:28px}.walk-finish h3{margin-bottom:10px}.walk-finish ul{padding-left:22px;margin:0;font-size:16px;line-height:1.9;list-style:disc}.walk-after{padding:32px 42px;background:#fcf9fd}.walk-after h2{margin-bottom:18px}.walk-last{padding:30px 42px;background:#fff0f6}.walk-net-buttons{display:flex;gap:12px;margin-top:20px}.walk-net-buttons a{display:flex;justify-content:center;align-items:center;flex:1;min-height:54px;border-radius:10px;color:#fff;background:#b91f60;font-weight:700}.walk-net-buttons a:nth-child(2){background:#7750b7}.walk a:focus-visible,.walk summary:focus-visible{outline:3px solid #7750b7;outline-offset:4px}@media(min-width:1101px){.walk{padding-right:244px}}@media(max-width:700px){.walk{padding:18px 14px 80px}.walk-intro,.walk-section,.walk-after,.walk-last{padding:26px 22px}.walk-intro .walk-text-link{margin-left:0;display:block}.walk-jumps{padding:12px;gap:3px}.walk-jumps a{font-size:12px;gap:4px;flex-direction:column}.walk h2{font-size:21px}.walk-choices{grid-template-columns:1fr}.walk-reference-grid{grid-template-columns:1fr}.walk-usims{gap:12px}.walk-usims figure{padding:14px;min-width:140px}.walk-usims img{height:160px}.walk-plans dl>div{grid-template-columns:65px 1fr}.walk-net-buttons{flex-direction:column}.walk-section-title{gap:10px}.walk-section>p,.walk-after p{font-size:16px}}
</style>
