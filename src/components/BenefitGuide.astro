---
import { benefitGuides } from "../data/benefit-guides.js";
import { toPublicPath } from "../lib/site-config.js";
const { benefitId }=Astro.props;
const guide=benefitGuides[benefitId];
---
{guide && <section class="section benefit-guide-section"><div class="wrap"><article class="benefit-guide">
  <header class="benefit-guide-header">
    <div class="benefit-guide-icon"><img src={toPublicPath(`/images/benefits/${guide.icon}`)} width="58" height="58" alt="" /></div>
    <div><span>앤텔레콤 공식 상세 안내 확인</span><h2>{guide.value}</h2><p>{guide.lead}</p></div>
  </header>
  <div class="benefit-guide-copy">
    <section class="benefit-fact"><h3>누가, 언제 받을 수 있나요?</h3><p>{guide.conditions}</p></section>
    <div class="benefit-guide-columns"><section><h3>12개월 기준으로 계산하면</h3><p>{guide.yearly}</p></section><section><h3>요금제는 이렇게 고르세요</h3><p>{guide.planChoice}</p></section></div>
    <section class="benefit-how"><h3>혜택 이용 방법</h3><ol>{guide.useSteps.map(step=><li>{step}</li>)}</ol></section>
    <section class="benefit-cautions"><h3>놓치기 쉬운 조건</h3><ul>{guide.cautions.map(item=><li>{item}</li>)}</ul></section>
    <section class="benefit-empathy"><h3>이런 분에게 실용적이에요</h3><p>{guide.fit}</p></section>
    <aside class="benefit-contact"><h3>문의처</h3><ul>{guide.contacts.map(item=><li>{item}</li>)}</ul></aside>
    <p class="benefit-source">앤텔레콤 요금제 상세 화면을 기준으로 확인했습니다. <a href={guide.sourceUrl} target="_blank" rel="noopener noreferrer">공식 상세 안내 보기</a></p>
  </div>
</article></div></section>}
