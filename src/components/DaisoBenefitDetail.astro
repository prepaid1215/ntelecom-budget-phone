---
import { plans, promoActive } from "../lib/catalog.js";
import { benefitGuides } from "../data/benefit-guides.js";
import { activationLink, toPublicPath, siteConfig } from "../lib/site-config.js";

const { model } = Astro.props;
const guide = benefitGuides["benefit-daiso"];
const planIds = ["ntelecom-k-7gb-daiso", "ntelecom-k-10gb-daiso", "ntelecom-k-15gb-daiso"];
const choices = planIds.map(id => plans.find(plan => plan.id === id)).filter(Boolean);
const won = value => Number(value).toLocaleString("ko-KR") + "원";
const dataLabel = plan => {
  const extra = promoActive(plan.promotion) ? (plan.monthly_extra_data_gb || 0) : 0;
  return extra ? `${plan.data_gb + extra}GB` : `${plan.data_gb}GB`;
};
const planPath = plan => toPublicPath(`/plans/k/item/${plan.id.replace("ntelecom-k-", "")}/`);
const applyPath = plan => activationLink("daiso_plan", { network: "kt", plan: plan.id, planName: plan.name });
const faq = model.faqs;
---

<section class="da-hero" aria-labelledby="da-title">
  <div class="wrap da-hero-grid">
    <div>
      <p class="da-kicker">KT망 후불 · 다이소 생활혜택</p>
      <h1 id="da-title">다이소 상품권 5,000원,<br /><em>휴대폰 요금제와 함께 받는 방법</em></h1>
      <p class="da-lead">다이소에서 평소 자주 사는 생활용품이 있다면, 통신비와 함께 비교해 볼 만한 선택입니다. 앤텔레콤 다이소 제휴 요금제의 가격과 상품권 조건을 한곳에 모았습니다.</p>
      <div class="da-pills"><span>다이소 모바일상품권 월 5,000원</span><span>KT 후불</span><span>신규가입·번호이동</span></div>
      <div class="da-hero-buttons">
        <a class="da-primary" href="#daiso-plans">요금제 먼저 비교하기</a>
        <a class="da-quiet" href="#daiso-terms">상품권 조건 확인하기</a>
      </div>
    </div>
    <div class="da-highlight" aria-label="다이소 제휴 요금제 주요 정보">
      <span class="da-highlight-eyebrow">생활혜택</span>
      <strong>5,000<small>원</small></strong>
      <p>지급 조건 충족 시 매월<br />다이소 모바일상품권 1매</p>
      <div class="da-highlight-bottom"><b>12개월 사용하면?</b><span>최대 60,000원 상당</span></div>
      <small>매월 조건 충족·기한 내 사용을 가정한 금액입니다. 통신요금 청구 할인은 아닙니다.</small>
    </div>
  </div>
</section>

<section class="section" id="daiso-plans">
  <div class="wrap">
    <div class="da-section-head"><span>요금제 비교</span><h2>다이소 혜택, 월 요금은 얼마일까요?</h2><p>상품권 금액을 요금에서 빼지 않고 실제 월 기본료를 그대로 표시했습니다. 데이터 사용량에 맞춰 선택해 보세요.</p></div>
    <div class="da-cards">
      {choices.map((plan, index) => <article class:list={["da-plan", { "da-plan-featured": index === 0 }]}>
        <div class="da-plan-top"><span>{index === 0 ? "와이파이를 자주 쓴다면" : index === 1 ? "데이터를 조금 더 넉넉히" : "외부에서 영상도 본다면"}</span><strong>{plan.data_gb}GB+</strong></div>
        <div class="da-plan-price"><small>월 기본료 · 부가세 포함</small><strong>{won(plan.monthly_price)}</strong></div>
        <dl>
          <div><dt>이번 달 데이터</dt><dd>{dataLabel(plan)}{promoActive(plan.promotion) && plan.monthly_extra_data_gb ? <small>기본 {plan.data_gb}GB + 프로모션 {plan.monthly_extra_data_gb}GB</small> : <small>기본 {plan.data_gb}GB</small>}</dd></div>
          <div><dt>소진 후</dt><dd>최대 {plan.after_speed}</dd></div>
          <div><dt>통화·문자</dt><dd>기본제공<small>영상·부가통화 300분</small></dd></div>
          <div><dt>다이소 혜택</dt><dd>월 5,000원 상품권<small>지급 조건 충족 시</small></dd></div>
        </dl>
        <a class="da-plan-link" href={planPath(plan)}>이 요금제 자세히 보기 <span aria-hidden="true">›</span></a>
        <a class="da-plan-apply" href={applyPath(plan)}>이 요금제로 가입하기</a>
      </article>)}
    </div>
    <div class="da-notice">
      <strong>추가 데이터는 모든 다이소 요금제에 적용되지 않습니다.</strong>
      <p>현재 등록된 상품 정보에서 7GB+와 10GB+는 대상 기간 내 개통하면 24개월간 매월 10GB 추가 제공 대상으로 안내됩니다. <b>15GB+에는 이 추가 데이터 혜택이 표시되어 있지 않습니다.</b> 프로모션 종료일 및 실제 가입 화면의 적용 여부를 확인하세요.</p>
    </div>
    <p class="da-source">요금제 기준: {siteConfig.ratesReceivedAt} 제공 목록 · 가입 시점의 실제 신청 화면이 최종 기준입니다.</p>
  </div>
</section>

<section class="section soft" id="daiso-terms">
  <div class="wrap">
    <div class="da-section-head"><span>혜택 사용 조건</span><h2>상품권은 언제, 어떻게 받을까요?</h2><p>처음 가입하자마자 받는 상품권은 아닙니다. 실제로 사용할 수 있도록 받는 과정과 주의할 점을 먼저 확인하세요.</p></div>
    <div class="da-flow">
      <article><b>01</b><h3>다이소 제휴 요금제 이용</h3><p>KT 후불 다이소 제휴 요금제로 신규가입하거나 번호이동합니다.</p></article>
      <article><b>02</b><h3>30일 사용·31일 차 유지</h3><p>사용일수 30일을 충족하고 31일 차까지 대상 요금제를 유지해야 첫 지급 조건을 충족합니다.</p></article>
      <article><b>03</b><h3>기프티쇼 문자 확인</h3><p>조건 충족 시 모바일상품권이 MMS로 발송됩니다. 발송일은 매월 같지 않을 수 있습니다.</p></article>
      <article><b>04</b><h3>기한 내 등록·사용</h3><p>발행일 기준 30일 안에 등록하고 사용해야 합니다. 미등록·미사용 시 소멸 및 재발행 제한이 있습니다.</p></article>
    </div>
    <div class="da-term-grid">
      <div class="da-term-card">
        <h3>어디서 사용할 수 있나요?</h3>
        <p>다이소몰에서는 상품권을 등록한 다음 결제할 때 사용할 수 있고, 사용 가능한 다이소 매장에서는 바코드를 제시합니다. 셀프계산대에서도 ‘다이소상품권’ 결제를 선택할 수 있습니다.</p>
        <a href="https://www.daisogift.co.kr/usestoreinfo" target="_blank" rel="noopener noreferrer">다이소 상품권 사용 가능 매장 확인 ›</a>
      </div>
      <div class="da-term-card">
        <h3>월 요금에서 5천 원 할인될까요?</h3>
        <p>아닙니다. 통신요금은 선택한 요금제의 기본료로 청구됩니다. 별도 지급되는 상품권은 현금 환급이나 통신요금 자동 할인과 다릅니다.</p>
        <p>쿠폰 미발송은 앤텔레콤 고객센터(1899-7700), 등록·사용은 기프티쇼(1588-6474)에서 확인할 수 있습니다.</p>
      </div>
    </div>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <div class="da-section-head"><span>가입 전 확인</span><h2>쓰던 휴대폰과 번호를 그대로 써도 될까요?</h2></div>
    <div class="da-compare">
      <article><span>번호이동</span><h3>지금 번호를 유지하고 싶다면</h3><p>사용 중인 휴대폰이 KT망과 호환되고 번호이동 조건을 충족하면, 쓰던 전화번호를 유지하며 알뜰폰으로 옮길 수 있습니다. 기존 통신사 약정·할부금 및 미납 여부는 미리 확인하세요.</p></article>
      <article><span>신규가입</span><h3>번호를 추가로 사용하고 싶다면</h3><p>별도의 번호가 필요한 경우 신규가입으로 진행할 수 있습니다. 가입할 통신망과 호환되는 휴대폰·유심, 본인확인 수단을 준비하세요.</p></article>
    </div>
    <div class="da-action"><div><strong>마음에 드는 요금제를 찾았다면</strong><p>요금제 선택부터 본인확인과 개통 신청까지 홈페이지에서 이어서 진행할 수 있습니다.</p></div><a href={activationLink("daiso_guide", { network:"kt" })}>KT 후불 가입 화면으로 이동</a></div>
  </div>
</section>

<section class="section soft">
  <div class="wrap">
    <div class="da-section-head"><span>자주 묻는 질문</span><h2>가입 전 많이 확인하는 내용</h2></div>
    <div class="faq-list">{faq.map(item => <details class="faq"><summary>{item.q}</summary><p>{item.a}</p></details>)}</div>
    <div class="da-more">
      <h3>다른 혜택과도 비교해 보세요</h3>
      <p>다이소를 잘 이용하지 않는다면 생활혜택보다 월 기본료가 낮은 상품이 더 나을 수 있습니다.</p>
      <div><a href={toPublicPath("/benefits/")}>앤텔레콤 생활혜택 전체 보기</a><a href={toPublicPath("/plans/k/")}>KT 후불 요금제 전체 비교</a><a href={toPublicPath("/guide/")}>온라인 개통방법 확인</a></div>
    </div>
  </div>
</section>

<style>
  .da-hero{background:linear-gradient(115deg,#fff7f4 0%,#fff 48%,#fff3f8 100%);border-bottom:1px solid #f1e5e7}
  .da-hero-grid{display:grid;grid-template-columns:minmax(0,1.45fr) minmax(270px,.8fr);gap:32px;align-items:center;padding:58px 22px}
  .da-kicker,.da-section-head>span{font-size:13px;font-weight:900;color:#b63559;letter-spacing:.3px}
  .da-hero h1{font-size:clamp(31px,4.3vw,49px);line-height:1.24;letter-spacing:-1.7px;margin:16px 0;word-break:keep-all}
  .da-hero h1 em{font-style:normal;color:#e22a6e}
  .da-lead{font-size:17px;line-height:1.85;color:#59515a;max-width:680px}
  .da-pills{display:flex;flex-wrap:wrap;gap:8px;margin:24px 0}.da-pills span{padding:7px 12px;border:1px solid #ead5dd;background:#fff;border-radius:999px;font-size:12px;font-weight:800}
  .da-hero-buttons{display:flex;flex-wrap:wrap;gap:10px}
  .da-primary,.da-quiet,.da-plan-apply,.da-action>a{padding:13px 18px;min-height:48px;border-radius:12px;display:inline-flex;align-items:center;justify-content:center;font-weight:900}
  .da-primary,.da-plan-apply,.da-action>a{background:#e52f76;color:#fff}.da-quiet{border:1px solid #e4cfd8;background:#fff}
  .da-highlight{border:1px solid #f5d5df;border-radius:26px;background:#fff;box-shadow:0 15px 36px rgba(202,70,113,.10);padding:27px;text-align:center}
  .da-highlight-eyebrow{display:inline-block;color:#b12e5b;background:#fff0f5;border-radius:20px;padding:6px 14px;font-size:12px;font-weight:850}
  .da-highlight>strong{display:block;font-size:clamp(48px,6vw,78px);letter-spacing:-3px;color:#df2870;line-height:1.3}.da-highlight>strong small{font-size:22px;letter-spacing:0}
  .da-highlight>p{font-weight:850;line-height:1.6;margin:3px 0 15px}
  .da-highlight-bottom{border-top:1px solid #f0e1e8;padding:16px 0 6px;display:flex;justify-content:space-between;gap:10px;font-size:14px}
  .da-highlight-bottom span{color:#bd285e;font-weight:900}.da-highlight>small{display:block;color:#6b6670;line-height:1.6;font-size:12px;text-align:left}
  .da-section-head h2{margin:8px 0 9px;font-size:clamp(25px,3vw,34px)}.da-section-head p{margin:0 0 22px;font-size:15px;color:#66606a;line-height:1.8}
  .da-cards{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}
  .da-plan{border:1px solid #e5e0e5;background:#fff;border-radius:21px;padding:20px;display:flex;flex-direction:column;gap:14px;min-width:0}
  .da-plan-featured{border:2px solid #ea4b85;background:linear-gradient(#fffafa,#fff)}
  .da-plan-top span{display:block;font-size:12px;color:#7c5970;font-weight:800}.da-plan-top strong{display:block;font-size:29px;letter-spacing:-1px;margin-top:4px}
  .da-plan-price{padding-bottom:12px;border-bottom:1px solid #eee}.da-plan-price small{display:block;color:#6d6670}.da-plan-price strong{display:block;font-size:28px;color:#d32469}
  .da-plan dl{margin:0}.da-plan dl>div{display:flex;justify-content:space-between;gap:8px;align-items:flex-start;margin:12px 0}
  .da-plan dt{font-size:12px;color:#666;flex-shrink:0}.da-plan dd{font-weight:850;font-size:14px;text-align:right;margin:0}.da-plan dd small{display:block;font-weight:500;color:#777;font-size:11px}
  .da-plan-link{display:flex;justify-content:space-between;align-items:center;font-weight:850;color:#bb2a60;font-size:13px;margin-top:auto;border-top:1px solid #f2e8ed;padding-top:11px}
  .da-plan-apply{display:flex;width:100%}
  .da-notice{margin-top:22px;border-radius:14px;padding:18px 22px;background:#fff6ee;border:1px solid #f4dfcc}
  .da-notice strong{color:#763d1d}.da-notice p{margin:6px 0 0;color:#60544c;font-size:14px;line-height:1.75}
  .da-source{color:#777;font-size:12px;margin:15px 0 0}
  .da-flow{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px}
  .da-flow article{background:#fff;border:1px solid #e6e2e7;padding:20px;border-radius:18px}.da-flow b{display:inline-grid;place-items:center;background:#fff0f5;color:#cc366f;border-radius:10px;width:38px;height:34px}
  .da-flow h3{font-size:16px;margin:12px 0 8px}.da-flow p,.da-term-card p,.da-compare p{font-size:14px;color:#635e66;line-height:1.8;margin:0}
  .da-term-grid,.da-compare{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px;margin-top:17px}
  .da-term-card,.da-compare article{padding:24px;background:#fff;border:1px solid #e7e1e7;border-radius:18px}
  .da-term-card h3,.da-compare h3{margin:0 0 10px;font-size:19px}.da-term-card p+p{margin-top:12px}
  .da-term-card>a{display:inline-block;color:#c32868;font-weight:850;margin-top:18px;font-size:13px}
  .da-compare{margin-top:0}.da-compare article>span{color:#c32868;font-size:12px;font-weight:900}
  .da-action{display:flex;justify-content:space-between;align-items:center;gap:20px;margin-top:24px;padding:22px 26px;background:#fff7f9;border:1px solid #f3dce6;border-radius:18px}
  .da-action strong{font-size:19px}.da-action p{font-size:13px;color:#666;margin:5px 0 0}
  .da-more{margin-top:30px;padding:24px;border-radius:18px;border:1px solid #ece5e8;background:#fff}.da-more h3{margin:0 0 7px}.da-more p{margin:0 0 14px;color:#666}
  .da-more>div{display:flex;gap:9px;flex-wrap:wrap}.da-more a{border:1px solid #dfd5db;border-radius:10px;padding:10px 12px;font-size:13px;font-weight:800}
  @media(max-width:850px){.da-hero-grid{grid-template-columns:1fr}.da-cards{grid-template-columns:1fr}.da-flow{grid-template-columns:1fr 1fr}.da-action{flex-direction:column;align-items:stretch}.da-action>a{width:100%}}
  @media(max-width:520px){.da-hero-grid{padding:38px 16px;gap:22px}.da-highlight{padding:20px}.da-flow,.da-term-grid,.da-compare{grid-template-columns:1fr}.da-plan{padding:17px}.da-action{padding:18px}.da-hero-buttons>*{width:100%}}
</style>
