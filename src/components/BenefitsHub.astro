---
import { siteConfig as site, activationLink, toPublicPath } from "../lib/site-config.js";
import { plans, benefits } from "../lib/catalog.js";
import PlanCard from "./PlanCard.astro";
const { model }=Astro.props;

const won=n=>n.toLocaleString("ko-KR")+"원";
const checked=benefits.map(b=>b.checked_at).filter(Boolean).sort().pop() || site.dataCheckedAt;
const [yy,mm,dd]=checked.split("-").map(Number);
const dataDate=`${yy}년 ${mm}월 ${dd}일`;

const icons={"benefit-coupang-cash":"coupang-cash.svg","benefit-naverpay":"naverpay.svg","benefit-daiso":"daiso.svg","benefit-millie":"millie.svg","benefit-oliveyoung":"oliveyoung.svg","benefit-cu":"cu.svg"};
const kinds={"benefit-coupang-cash":"상품권","benefit-naverpay":"포인트","benefit-daiso":"상품권","benefit-oliveyoung":"상품권","benefit-millie":"구독","benefit-cu":"결제 할인"};
const slug=b=>b.id.replace("benefit-","");

const rows=benefits.filter(b=>b.active).map(b=>{
  const ps=plans.filter(p=>(p.benefit_ids||[]).includes(b.id));
  return {b,count:ps.length,low:Math.min(...ps.map(p=>p.monthly_price))};
});

// 같은 구성(K망, 통화·문자 기본제공)의 데이터 구간별 혜택 가격
const tiers=[7,10,15,100].map(gb=>{
  const list=plans.filter(p=>p.network==="K" && p.data_gb===gb && !p.daily_data_gb && p.calls.startsWith("기본제공") && (p.benefit_ids||[]).length)
    .map(p=>({p,b:benefits.find(x=>x.id===p.benefit_ids[0])}))
    .sort((a,b)=>a.p.monthly_price-b.p.monthly_price || a.b.name.localeCompare(b.b.name,"ko"));
  const min=list[0]?.p.monthly_price, max=list[list.length-1]?.p.monthly_price;
  return {gb,list,min,max,sample:list[0]?.p};
}).filter(t=>t.list.length);
const t7=tiers.find(t=>t.gb===7);
const cheapNames=t7 ? t7.list.filter(x=>x.p.monthly_price===t7.min).map(x=>x.b.name).join("·") : "";
---
<section class="section"><div class="wrap">
  <h2>혜택 6가지, 한눈에 비교</h2>
  <p class="section-lead">모두 K망 요금제에 붙는 혜택이에요. 받는 방법과 조건이 다르니 평소 자주 쓰는 곳을 기준으로 고르세요.</p>
  <div class="bh-grid">{rows.map(({b,count,low})=>
    <a class="bh-card" href={toPublicPath(`/benefits/${slug(b)}/`)}>
      <div class="bh-top"><span class="bh-icon"><img src={toPublicPath(`/images/benefits/${icons[b.id]}`)} width="22" height="22" alt="" loading="lazy" decoding="async" /></span><div><strong>{b.name}</strong><em>{kinds[b.id]}</em></div></div>
      <p class="bh-value">{b.value}</p>
      <dl>
        <div><dt>받는 방법</dt><dd>{b.delivery_method}</dd></div>
        <div><dt>조건</dt><dd>{b.conditions}</dd></div>
      </dl>
      <div class="bh-foot"><span>요금제 {count}개 · {won(low)}~</span><b>자세히 ›</b></div>
    </a>)}
  </div>
</div></section>

<section class="section soft"><div class="wrap">
  <h2>같은 데이터인데 가격이 달라요</h2>
  <p class="section-lead">{t7 ? `같은 7GB라도 ${cheapNames} 요금제는 ${won(t7.min)}, 나머지는 ${won(t7.max)}이에요. ` : ""}데이터 구간별로 혜택에 따라 월 기본료가 이렇게 나뉘어요.</p>
  <div class="bh-tiers">{tiers.map(t=>
    <div class="bh-tier">
      <div class="bh-tier-head"><strong>{t.gb}GB</strong><span>소진 후 {t.sample.after_speed} · 통화·문자 기본제공</span></div>
      <div class="cmp-table">{t.list.map(({p,b})=>
        <a class:list={["cmp-row",{"is-current":p.monthly_price===t.min}]} href={toPublicPath(`/plans/k/item/${p.id.replace("ntelecom-k-","")}/`)}><span>{b.name}</span><strong>{won(p.monthly_price)}</strong><em>{p.monthly_price===t.min ? "최저가" : "+"+won(p.monthly_price-t.min)}</em></a>)}
      </div>
    </div>)}
  </div>
  <p class="pd-note">혜택은 조건을 채워야 받을 수 있어요. 가격만 보지 말고 평소 쓰는 곳인지 먼저 확인하세요.</p>
</div></section>

<section class="section"><div class="wrap">
  <h2>고르기 전에 알아둘 점</h2>
  <div class="bh-notes">
    <article><strong>상품권·포인트 4종</strong><p>쿠팡캐쉬·네이버페이·다이소·올리브영은 매월 5,000원(P) 쿠폰을 문자(MMS)로 받아요. 가입·변경일부터 사용일수 30일을 채우고 31일차까지 요금제를 유지해야 하고, 발행 후 30일 안에 등록해야 해요.</p></article>
    <article><strong>밀리의서재</strong><p>월 11,900원 구독권이 요금제를 유지하는 동안 제공돼요. 앱에서 제휴 구독을 직접 활성화해야 하고, 이미 쓰는 구독과는 중복이 제한될 수 있어요.</p></article>
    <article><strong>CU</strong><p>포켓CU에서 제휴 인증을 하면 QR 결제 때 20%가 할인돼요. 월 한도는 5,000원이고 이월되지 않아요. 한도를 다 채우려면 매월 25,000원 이상 결제해야 해요.</p></article>
  </div>
  <p class="pd-note">혜택 조건은 {dataDate} 기준이에요. 요금제를 바꾸면 혜택이 중단되거나 기준일이 다시 시작될 수 있어요.</p>
</div></section>

<section class="section soft"><div class="wrap">
  <h2>혜택 포함 요금제 전체</h2>
  <p class="section-lead">{model.matched.length}개 요금제를 월 기본료순으로 모았어요.</p>
  <details class="all-plans-details"><summary>전체 요금제 {model.matched.length}개 보기 <span>⌄</span></summary><div class="grid cols-3">{[...model.matched].sort((a,b)=>a.monthly_price-b.monthly_price || a.name.localeCompare(b.name,"ko")).map(p=><PlanCard plan={p} slot="list"/>)}</div></details>
</div></section>

<section class="section"><div class="wrap">
  <h2>신청부터 개통까지</h2>
  <p class="section-lead">준비물은 딱 2개예요. <b>편의점 유심</b>과 <b>간편인증서 1가지</b>면 돼요.</p>
  <div class="steps">
    <article class="step"><span>1</span><div><strong>유심 구매</strong><p>바로유심(8982로 시작하는 19자리)을 CU, GS25, 이마트24에서 구매하세요.</p></div></article>
    <article class="step"><span>2</span><div><strong>신청 페이지 접속</strong><p>‘신청하기’를 눌러 개통 페이지로 이동한 뒤 요금제를 고르고 안면인증·간편인증으로 본인 확인을 진행해요.</p></div></article>
    <article class="step"><span>3</span><div><strong>유심번호 입력 후 신청</strong><p>유심번호 19자리 숫자를 입력해요.</p></div></article>
    <article class="step"><span>4</span><div><strong>해피콜 받고 개통</strong><p>신청만으로는 개통되지 않아요. 본사 확인 전화(해피콜)를 받아야 개통이 완료돼요. 순번 대기가 있을 수 있으니 전화를 꼭 받아 주세요.</p></div></article>
  </div>
  <p class="pd-note">막히는 부분이 있으면 <a href={site.business.kakao} rel="noopener">카카오톡 채널</a> 또는 {site.business.phone}으로 바로 문의하세요. 운영시간: {site.business.hours}</p>
</div></section>

<section class="section soft"><div class="wrap"><h2>자주 묻는 질문</h2><div class="faq-list">{model.faqs.map(f=><details class="faq"><summary>{f.q}</summary><p>{f.a}</p></details>)}</div></div></section>

<section class="section"><div class="wrap final-box"><h2>평소 쓰는 곳의 혜택을 골랐다면</h2><p>신청 후 해피콜을 받으면 개통이 완료돼요.</p><a class="final-button" href={activationLink("final")}>바로 신청하기</a></div></section>
