---
import { siteConfig as site, activationLink, toPublicPath } from "../lib/site-config.js";
import { plans } from "../lib/catalog.js";
import UsimThumb from "./UsimThumb.astro";
const { model }=Astro.props;
const biz=site.business;
const won=n=>n.toLocaleString("ko-KR")+"원";

const portable=plans.filter(p=>p.port_available===true);
const unknownNet=plans.filter(p=>p.port_available!==true);
const tierDefs=[[7,"/number-transfer/7gb/"],[10,"/number-transfer/10gb/"],[15,"/number-transfer/15gb/"],[100,"/number-transfer/100gb/"]];
const tiers=tierDefs.map(([gb,href])=>{
  const list=portable.filter(p=>p.data_gb===gb && !p.daily_data_gb && p.calls.startsWith("기본제공"));
  const prices=list.map(p=>p.monthly_price);
  return list.length ? {gb,href,count:list.length,min:Math.min(...prices),max:Math.max(...prices),speed:list[0].after_speed} : null;
}).filter(Boolean);
const lowest=Math.min(...portable.map(p=>p.monthly_price));
---
<section class="section"><div class="wrap">
  <h2>번호이동, 먼저 이것만 확인하세요</h2>
  <p class="section-lead">쓰던 번호를 그대로 옮기는 가입이에요. 아래 두 가지에 걸리지 않으면 대부분 바로 신청할 수 있어요.</p>
  <div class="nt-check">
    <article class="is-ok"><b>이러면 가능해요</b><ul><li>통신 요금을 연체하지 않았어요</li><li>최근 3개월 안에 번호이동을 하지 않았어요</li></ul></article>
    <article class="is-no"><b>이러면 제한돼요</b><ul><li>요금을 연체 중이에요</li><li>번호이동한 지 3개월이 지나지 않았어요<small>번호이동관리센터에 직접 신청하는 예외가 있어요</small></li></ul></article>
  </div>
  <p class="pd-note">제한에 걸린다면 새 번호로 시작하는 <a href={toPublicPath("/new-number/")}>신규가입</a>도 있어요. 두 번째 번호로 쓰기에도 좋아요.</p>
</div></section>

<section class="section soft" id="nt-plans"><div class="wrap">
  <h2>번호이동이 되는 요금제 {portable.length}개</h2>
  <p class="section-lead">모두 K망(KT망) 요금제예요. {lowest.toLocaleString("ko-KR")}원부터 있고, 데이터 구간별 가격은 이래요.</p>
  <div class="ch-table-wrap"><table class="ch-table gd-table">
    <thead><tr><th>데이터</th><th>월 기본료</th><th>소진 후 속도</th><th></th></tr></thead>
    <tbody>{tiers.map(t=><tr>
      <th scope="row">{t.gb}GB<small>기본제공 통화·문자</small></th>
      <td><b>{won(t.min)}</b>{t.max>t.min && <small>~ {won(t.max)}</small>}</td>
      <td>{t.speed ? "최대 "+t.speed : "-"}</td>
      <td><a class="nt-go" href={toPublicPath(t.href)}>{t.count}개 보기 ›</a></td>
    </tr>)}</tbody>
  </table></div>
  <p class="pd-note">같은 데이터라도 붙는 혜택(쿠팡캐쉬, 밀리의서재 등)에 따라 가격이 달라요. 통화 100분·300분 제한형과 매일 데이터 요금제는 전체 목록에서 볼 수 있어요.</p>
  <div class="link-list" style="margin-top:14px">
    <a href={toPublicPath("/benefits/")}><span>혜택별로 번호이동 요금제 고르기</span><span>›</span></a>
    <a href={toPublicPath("/card/")}><span>제휴카드 할인까지 계산해 보기</span><span>›</span></a>
  </div>
  {unknownNet.length>0 && <div class="gd-callout"><strong>L망(LG U+) 요금제는 먼저 문의해 주세요</strong><p>L망 요금제 {unknownNet.length}개는 번호이동 가능 여부가 확인되지 않았어요. L망으로 번호이동을 원하면 신청 전에 카카오톡 채널이나 {biz.phone}으로 문의해 주세요.</p></div>}
</div></section>

<section class="section"><div class="wrap">
  <h2>번호이동 신청 순서</h2>
  <p class="section-lead">준비물은 딱 2개예요. <b>편의점 유심</b>과 <b>간편인증서 1가지</b>면 돼요.</p>
  <div class="steps">
    <article class="step"><span>1</span><div><strong>유심 구매</strong><p>K망은 바로유심(8982로 시작하는 19자리)을 CU, GS25, 이마트24에서 구매하세요.</p><UsimThumb network="K"/></div></article>
    <article class="step"><span>2</span><div><strong>신청 페이지에서 번호이동 선택</strong><p>‘신청하기’를 눌러 개통 페이지로 이동한 뒤 안면인증·간편인증으로 본인 확인을 하고, 가입 유형에서 번호이동을 선택해요.</p></div></article>
    <article class="step"><span>3</span><div><strong>유심번호 입력 후 신청</strong><p>유심번호 19자리 숫자를 입력하고 요금제를 골라 신청을 마쳐요.</p></div></article>
    <article class="step"><span>4</span><div><strong>유심 꽂고 바로 사용</strong><p>신청이 끝나면 개통이 완료돼요. 유심을 휴대폰에 꽂으면 바로 쓸 수 있어요. 사용 중에 <b>1899-7700</b>으로 본사 확인 전화(해피콜)가 오면 꼭 받아 주세요. 받지 않으면 회선이 해지될 수 있어요.</p></div></article>
  </div>
  <p class="pd-note">번호이동이 끝나면 기존 통신사 회선은 해지돼요. 기존 통신사에 약정이나 할부금이 남아 있다면 위약금과 잔여 할부금이 청구될 수 있으니, 신청 전에 기존 통신사에서 확인하세요.</p>
</div></section>

<section class="section soft"><div class="wrap">
  <h2>막혔을 때는 이렇게</h2>
  <dl class="spec-table gd-trouble">
    <div><dt>번호이동이 거절돼요</dt><dd>요금 연체 여부와 최근 3개월 안 번호이동 이력을 확인하세요. 연체 요금을 먼저 납부하면 다시 신청할 수 있어요.</dd></div>
    <div><dt>3개월이 안 지났어요</dt><dd>번호이동관리센터에 직접 신청하는 예외가 있어요. 막히면 문의해 주세요.</dd></div>
    <div><dt>본인 확인이 안 돼요</dt><dd>본인 명의 휴대폰의 간편인증으로 진행하는지 확인하세요.</dd></div>
    <div><dt>유심번호가 오류가 나요</dt><dd>K망은 19자리 숫자예요. 바로유심이 맞는지 확인하세요.</dd></div>
  </dl>
  <div class="gd-contact">
    <strong>바로 물어보세요</strong>
    <a class="btn-primary" href={biz.kakao} rel="noopener">카카오톡 채팅 상담</a>
    <a class="btn-secondary" href={`tel:${biz.phone}`}>{biz.phone}</a>
    <p>{biz.hours}</p>
  </div>
  <div class="link-list" style="margin-top:14px">
    <a href={toPublicPath("/number-transfer/restrictions/")}><span>번호이동 제한 조건 자세히 보기</span><span>›</span></a>
    <a href={toPublicPath("/guide/")}><span>개통 방법 전체 보기</span><span>›</span></a>
  </div>
</div></section>

<section class="section"><div class="wrap"><h2>자주 묻는 질문</h2><div class="faq-list">{model.faqs.map(f=><details class="faq"><summary>{f.q}</summary><p>{f.a}</p></details>)}</div></div></section>

<section class="section soft"><div class="wrap final-box"><h2>번호 그대로, 지금 옮겨 보세요</h2><p>신청하면 개통돼서 바로 쓸 수 있어요. 해피콜은 꼭 받아 주세요.</p><a class="final-button" href={activationLink("final")}>번호이동 신청하기</a></div></section>
