---
import { promoActive } from "../lib/catalog.js";
const { card, plan=null }=Astro.props;
const promo=promoActive(card.promotion);
const promoTiers=promo ? (card.promotion.additional_discount_tiers||[]) : [];
const promoDiscountFor=tier=>promoTiers.find(p=>p.monthly_spend===tier.monthly_spend)?.monthly_discount||0;
---
<div class="card-zone">
  <h3>{card.name}</h3>
  <p>{card.card_company} · 연회비 {card.annual_fee?.toLocaleString("ko-KR")}원 · 통신요금 자동납부 조건</p>
  <div class="tier-table">
    {card.discount_tiers.map(t => (
      <div class="tier-row">
        <span>전월 {Math.round(t.monthly_spend/10000)}만원 이상</span>
        <strong>기본 {t.monthly_discount.toLocaleString("ko-KR")}원 할인{t.maximum_with_living_autopay ? ` · 생활요금 포함 최대 ${t.maximum_with_living_autopay.toLocaleString("ko-KR")}원` : ""}</strong>
      </div>
    ))}
  </div>
  {promo && <div class="promo-note"><strong>현재 기간 한정 프로모션</strong><br />{card.promotion.description}</div>}
  {plan && <div class="card-calculations">
    <strong>{plan.name} 할인 예시</strong>
    {card.discount_tiers.map(t => {
      const extra=promoDiscountFor(t);
      const final=Math.max(0,plan.monthly_price-t.monthly_discount-extra);
      return <div class="card-calculation">
        <span>전월 {Math.round(t.monthly_spend/10000)}만원 이상</span>
        <dl>
          <div><dt>월 기본료</dt><dd>{plan.monthly_price.toLocaleString("ko-KR")}원</dd></div>
          <div><dt>카드 기본할인</dt><dd>-{t.monthly_discount.toLocaleString("ko-KR")}원</dd></div>
          {extra>0 && <div><dt>기간 추가할인</dt><dd>-{extra.toLocaleString("ko-KR")}원</dd></div>}
          <div class="calculation-total"><dt>조건 충족 시</dt><dd>{final.toLocaleString("ko-KR")}원</dd></div>
        </dl>
      </div>;
    })}
    <p>카드 할인은 조건 충족 시 별도 적용되며 요금제 기본료를 변경하지 않습니다.</p>
  </div>}
</div>
