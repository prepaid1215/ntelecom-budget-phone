---
import { siteConfig as site, activationLink, toPublicPath } from "../lib/site-config.js";
import { plans, benefitById, cardsForPlan, benefitsForPlan, promoActive, stripPromoText } from "../lib/catalog.js";
import CardOffer from "./CardOffer.astro";
import UsimThumb from "./UsimThumb.astro";
import UsimNumberGuide from "./UsimNumberGuide.astro";
const { model }=Astro.props;
const plan=model.one;
const { page }=model;

const won=n=>n.toLocaleString("ko-KR")+"원";
const shortId=p=>p.id.replace("ntelecom-k-","").replace("ntelecom-l-","");
const planPath=p=>toPublicPath(`/plans/${p.network.toLowerCase()}/item/${shortId(p)}/`);
const displayName=p=>p.name.replace(/^앤텔레콤\s+/,"");
const benefitLabel=p=>{
  const b=(p.benefit_ids||[]).map(benefitById).filter(Boolean)[0];
  return b ? b.name : "혜택 없음";
};
const diffLabel=p=>{
  if(p.id===plan.id) return "지금 보는 요금제";
  const d=p.monthly_price-plan.monthly_price;
  return d===0 ? "같은 가격" : (d>0 ? "+" : "-")+won(Math.abs(d));
};
const dateKo=iso=>{ const [y,m,d]=iso.split("-").map(Number); return `${y}년 ${m}월 ${d}일`; };

const operator=plan.network==="K" ? "KT" : "LG U+";
const dataMain=plan.data_gb ? `${plan.data_gb}GB` : plan.daily_data_gb ? `매일 ${plan.daily_data_gb}GB` : "";
const dataSub=[
  plan.data_gb && plan.daily_data_gb ? `+ 매일 ${plan.daily_data_gb}GB` : null,
  plan.monthly_extra_data_gb ? `+ 매월 ${plan.monthly_extra_data_gb}GB 추가` : null
].filter(Boolean).join(" ");
const promoOn=promoActive(plan.promotion);
const benefits=benefitsForPlan(plan);
const cards=cardsForPlan(plan);

// 같은 구성, 혜택만 다른 요금제
const sameSpec=plans.filter(p=>p.network===plan.network && p.data_gb===plan.data_gb && p.daily_data_gb===plan.daily_data_gb && p.calls===plan.calls && p.after_speed===plan.after_speed && p.monthly_extra_data_gb===plan.monthly_extra_data_gb)
  .sort((a,b)=>a.monthly_price-b.monthly_price);
const cheapestSame=sameSpec[0];
// 같은 망·같은 혜택의 다른 데이터 구간
const sameBenefitKey=(plan.benefit_ids||[]).join(",");
const otherTiers=plans.filter(p=>p.network===plan.network && (p.benefit_ids||[]).join(",")===sameBenefitKey)
  .sort((a,b)=>a.monthly_price-b.monthly_price);

// 카드 적용 납부액
const rows=[{label:"카드 할인 없이",monthly:plan.monthly_price}];
const primary=cards[0];
if(primary){
  const promo=promoActive(primary.promotion);
  const extraTiers=promo ? (primary.promotion.additional_discount_tiers||[]) : [];
  for(const t of primary.discount_tiers){
    const extra=extraTiers.find(x=>x.monthly_spend===t.monthly_spend)?.monthly_discount||0;
    rows.push({label:`${primary.name} · 전월 ${Math.round(t.monthly_spend/10000)}만원 이상`,monthly:Math.max(0,plan.monthly_price-t.monthly_discount-extra)});
  }
}
const best=rows[rows.length-1];

const specRows=[
  ["통신망",`${operator}망(${plan.network}망) · ${plan.network_type||"LTE"}`],
  ["월 기본료",`${won(plan.monthly_price)}${plan.vat_included ? " (부가세 포함)" : ""}`],
  ["기본 데이터",`${dataMain}${dataSub ? " "+dataSub : ""}`],
  ["소진 후 속도",plan.after_speed ? `최대 ${plan.after_speed}` : null],
  ["통화",plan.calls],
  ["문자",plan.sms],
  ["약정",plan.contract||null],
  ["유심",plan.physical_sim_available===true ? `일반 유심(${(plan.sim_types||[]).join(", ")||"USIM"}) 사용` : null],
  ["신규가입",plan.new_available===true ? "가능" : null],
  ["번호이동",plan.port_available===true ? "가능" : null],
  ["제공 혜택",benefits.length ? benefits.map(b=>b.name).join(", ") : null]
].filter(r=>r[1]);
const unknowns=[
  plan.esim_available==null && "eSIM 지원 여부",
  plan.hotspot==null && "핫스팟(테더링) 허용 여부"
].filter(Boolean);

const adLabel={price:"월 요금",card:"카드 할인","number-transfer":"번호이동","new-number":"신규가입",benefit:"혜택"}[page.adAngle];
---
<section class="pd-hero"><div class="wrap pd-hero-inner">
  <div class="pd-title">
    <span class="eyebrow">{operator}망 · {plan.network_type||"LTE"} · 요금제</span>
    <h1>{displayName(plan)}</h1>
    <div class="plan-badges">{plan.contract && <span class="badge">{plan.contract}</span>}{benefits.map(b=><span class="badge">{b.name}</span>)}{promoOn && <span class="badge">프로모션 진행 중</span>}</div>
    {page.pageType==="ad" && adLabel && <p class="pd-adline">{promoOn ? page.angle : stripPromoText(page.angle)}</p>}
  </div>
  <div class="pd-price">
    <small>월 기본료</small>
    <strong>{won(plan.monthly_price)}</strong>
    {primary && <span class="pd-price-low">카드 할인 시 최저 <b>{won(best.monthly)}</b></span>}
  </div>
  <div class="pd-keys">
    <div><small>데이터</small><b>{dataMain}</b>{dataSub && <i>{dataSub}</i>}</div>
    <div><small>소진 후</small><b>{plan.after_speed ? `${plan.after_speed}` : "-"}</b><i>최대 속도</i></div>
    <div><small>통화·문자</small><b>{plan.sms==="기본제공" ? "기본제공" : plan.sms}</b><i>{plan.calls.replace(/^기본제공\s*/,"") || "무제한"}</i></div>
  </div>
  <div class="hero-actions pd-actions"><a class="btn-primary" href={activationLink("hero")}>이 요금제로 신청하기</a><a class="btn-secondary" href={site.business.kakao} rel="noopener">카톡으로 먼저 물어보기</a></div>
</div></section>

<section class="section"><div class="wrap"><h2>요금제 정보</h2>
  <dl class="spec-table">{specRows.map(([k,v])=><div><dt>{k}</dt><dd>{v}</dd></div>)}</dl>
  {promoOn && <div class="promo-note pd-promo"><strong>프로모션</strong><br />{plan.promotion.description}{plan.promotion.end_date ? ` · ${dateKo(plan.promotion.end_date)}까지` : ""}</div>}
  {unknowns.length>0 && <p class="pd-unknown">{unknowns.join(", ")}는 상담 시 안내해 드려요.</p>}
</div></section>

{primary && <section class="section soft"><div class="wrap"><h2>카드 할인 받으면 실제 얼마?</h2>
  <div class="pay-table">
    <div class="pay-head"><span>조건</span><span>월 납부액</span><span>12개월</span></div>
    {rows.map(r=><div class="pay-row"><span>{r.label}</span><strong>{won(r.monthly)}</strong><em>{won(r.monthly*12)}</em></div>)}
  </div>
  <p class="pd-note">할인은 전월 카드 실적을 채우고 통신요금을 자동납부할 때 적용돼요.</p>
  <div class="grid cols-2" style="margin-top:16px">{cards.map(c=><CardOffer card={c} />)}</div>
</div></section>}

<section class="section"><div class="wrap"><h2>{plan.data_gb ? `같은 ${plan.data_gb}GB` : "같은 구성"}, 혜택별 가격</h2>
  {sameSpec.length>1
    ? <p class="section-lead">{cheapestSame.id===plan.id ? "이 요금제가 같은 구성 중 가장 저렴해요." : `같은 구성에서 ${benefitLabel(cheapestSame)} 요금제가 ${won(plan.monthly_price-cheapestSame.monthly_price)} 더 저렴해요.`} 혜택에 따라 월 기본료가 달라져요.</p>
    : <p class="section-lead">이 구성은 혜택별로 나뉘지 않고 한 가지 가격으로 판매돼요.</p>}
  {sameSpec.length>1 && <div class="cmp-table">{sameSpec.map(p=><a class:list={["cmp-row",{"is-current":p.id===plan.id}]} href={planPath(p)}><span>{benefitLabel(p)}</span><strong>{won(p.monthly_price)}</strong><em>{diffLabel(p)}</em></a>)}</div>}
</div></section>

<section class="section soft"><div class="wrap"><h2>{plan.network}망{benefits.length ? ` ${benefits[0].name}` : ""} 요금제 전체</h2>
  <p class="section-lead">데이터가 달라지면 가격이 어떻게 달라지는지 비교해 보세요.</p>
  <div class="cmp-table">{otherTiers.map(p=><a class:list={["cmp-row",{"is-current":p.id===plan.id}]} href={planPath(p)}><span>{p.data_gb ? `${p.data_gb}GB` : `매일 ${p.daily_data_gb}GB`}{p.data_gb && p.daily_data_gb ? ` + 일${p.daily_data_gb}GB` : ""}<small>{p.calls.startsWith("기본제공") ? "통화·문자 기본제공" : `통화 ${p.calls.split(" ")[0]} · 문자 ${p.sms}`} · 소진 후 {p.after_speed}</small></span><strong>{won(p.monthly_price)}</strong><em>{p.id===plan.id ? "지금 보는 요금제" : diffLabel(p)}</em></a>)}</div>
</div></section>

{benefits.length>0 && <section class="section"><div class="wrap"><h2>{benefits.map(b=>b.name).join(" · ")} 혜택</h2>
  <div class="grid cols-2">{benefits.map(b=><article class="benefit-box" style="min-height:0">
    <strong>{b.value}</strong>
    <p>{b.conditions}</p>
    <small>{b.delivery_method} · {b.delivery_timing}</small>
    <a href={toPublicPath(`/benefits/${b.id.replace("benefit-","")}/`)}>{b.name} 지급·사용 조건 자세히 보기 ›</a>
  </article>)}</div>
</div></section>}

<section class="section soft"><div class="wrap"><h2>신청부터 개통까지</h2>
  <p class="section-lead">준비물은 딱 2개예요. <b>편의점 유심</b>과 <b>간편인증서 1가지</b>면 돼요.</p>
  <div class="steps steps-flow">
    <article class="step"><span>1</span><div><strong>유심 구매</strong><p>{plan.network==="K" ? "바로유심(8982로 시작하는 19자리)을 CU, GS25, 이마트24에서 구매하세요." : "모두의 원칩을 이마트24, 배민 B마트, 스토리웨이에서 구매하세요. 다이소 고고비 유심도 L망에서 사용할 수 있어요."}</p><UsimThumb network={plan.network}/></div></article>
    <article class="step"><span>2</span><div><strong>신청 페이지 접속</strong><p>‘신청하기’를 눌러 개통 페이지로 이동한 뒤 안면인증·간편인증으로 본인 확인을 진행해요.</p></div></article>
    <article class="step"><span>3</span><div><strong>유심번호 입력 후 신청</strong><p>{plan.network==="K" ? "유심 일련번호 숫자 19자리를 입력해요. 마지막 알파벳 F는 빼고 입력하세요." : "모델명(알파벳 1개+숫자 4개, 예: U8680)과 유심번호(숫자 8개, 예: 00123456)를 입력해요."}</p><UsimNumberGuide/></div></article>
    <article class="step"><span>4</span><div><strong>유심 꽂고 바로 사용</strong><p>신청이 끝나면 개통이 완료돼요. 유심을 휴대폰에 꽂으면 바로 쓸 수 있어요. 사용 중에 본사 확인 전화(해피콜, 1899-7700)가 오면 꼭 받아 주세요. 받지 않으면 회선이 해지될 수 있어요.</p></div></article>
  </div>
  <p class="pd-note">인증이 계속 안 되거나 막히는 부분이 있으면 <a href={site.business.kakao} rel="noopener">카카오톡 채널</a>로 바로 문의하세요. 운영시간: {site.business.hours}</p>
</div></section>

<section class="section"><div class="wrap"><h2>자주 묻는 질문</h2><div class="faq-list">{model.faqs.map(f=><details class="faq"><summary>{f.q}</summary><p>{f.a}</p></details>)}</div></div></section>

<section class="section soft"><div class="wrap"><h2>함께 보면 좋은 페이지</h2><div class="link-list">{model.related.map(p=><a href={toPublicPath(p.path)}><span>{p.keyword}</span><span>›</span></a>)}</div><div class="data-note">요금 정보는 {dateKo(site.dataCheckedAt)} 기준이에요. 프로모션·혜택·카드 조건은 가입 시점에 달라질 수 있어요.</div></div></section>

<section class="section"><div class="wrap final-box"><h2>{displayName(plan)}, 신청해 볼까요?</h2><p>신청하면 개통돼서 바로 쓸 수 있어요. 해피콜은 꼭 받아 주세요.</p><a class="final-button" href={activationLink("final")}>바로 신청하기</a></div></section>
