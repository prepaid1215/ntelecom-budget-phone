---
import { toPublicPath } from "../lib/site-config.js";
// network: "K" | "L" | "both"
const { network="both" }=Astro.props;
const items={
  K:{src:"/images/usim/baro-usim.webp",w:560,h:699,alt:"KT 바로유심 패키지",cap:"K망 · 바로유심"},
  L:{src:"/images/usim/onechip.webp",w:560,h:560,alt:"LG U+ 모두의 원칩 패키지",cap:"L망 · 모두의 원칩"}
};
const list=network==="both" ? [items.K,items.L] : [items[network]];
---
<div class:list={["usim-thumbs",{"is-single":list.length===1}]}>{list.map(i=><figure><img src={toPublicPath(i.src)} width={i.w} height={i.h} alt={i.alt} loading="lazy" decoding="async" /><figcaption>{i.cap}</figcaption></figure>)}</div>
