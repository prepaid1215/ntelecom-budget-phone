---
import { siteConfig as site, toPublicPath } from "../lib/site-config.js";
import PlanCard from "./PlanCard.astro";
import CardOffer from "./CardOffer.astro";
import BenefitOffer from "./BenefitOffer.astro";
const { model }=Astro.props;
const [yy,mm,dd]=site.dataCheckedAt.split("-").map(Number);
const dataDate=`${yy}년 ${mm}월 ${dd}일`;
const plans=model.matched;
const cheapest=(tag)=>plans.filter(p=>p.tags.includes(tag)).sort((a,b)=>a.monthly_price-b.monthly_price)[0];
const featured=[cheapest("7gb"),cheapest("15gb"),cheapest("100gb")].filter(Boolean);
---
<section class="quick"><div class="wrap quick-inner">
  <a href={toPublicPath("/plans/")}><span class="quick-icon"><img src={toPublicPath("/images/quick-plans.webp")} width="64" height="64" alt="" loading="lazy" decoding="async" /></span><b>요금제</b><small>데이터별로 보기</small></a>
  <a href={toPublicPath("/number-transfer/")}><span class="quick-icon"><img src={toPublicPath("/images/quick-transfer.webp")} width="64" height="64" alt="" loading="lazy" decoding="async" /></span><b>번호이동</b><small>번호 그대로</small></a>
  <a href={toPublicPath("/card/")}><span class="quick-icon"><img src={toPublicPath("/images/quick-card.webp")} width="64" height="64" alt="" loading="lazy" decoding="async" /></span><b>제휴카드</b><small>할인 조건</small></a>
  <a href={toPublicPath("/benefits/")}><span class="quick-icon"><img src={toPublicPath("/images/quick-benefits.webp")} width="64" height="64" alt="" loading="lazy" decoding="async" /></span><b>생활혜택</b><small>쿠팡·네이버페이 등</small></a>
</div></section>

<section class="section soft"><div class="wrap"><h2>많이 선택하는 요금제</h2><p class="section-lead">7GB, 15GB, 100GB 구간에서 가장 저렴한 상품이에요.</p><div class="grid cols-3">{featured.map(p=><PlanCard plan={p} slot="home"/>)}</div></div></section>

<section class="section"><div class="wrap"><h2>제휴카드 할인까지 계산해 보면</h2><p class="section-lead">월 기본료에서 카드 할인을 뺀 실제 납부액을 예시로 보여드려요.</p><div class="grid cols-2">{model.cards.map(c=><CardOffer card={c} plan={plans.filter(p=>(c.eligible_networks||[]).includes(p.network)).sort((a,b)=>a.monthly_price-b.monthly_price)[0]}/>)}</div></div></section>

<section class="section dark"><div class="wrap"><h2>앤텔레콤 알뜰폰, 이런 점이 좋아요</h2><div class="grid cols-3">
  <div class="card"><strong>약정 없이 시작</strong><p>위약금 걱정 없이 가입하고, 필요하면 언제든 바꿀 수 있어요.</p></div>
  <div class="card"><strong>K망 · L망 선택</strong><p>KT망(K망)과 LG U+망(L망) 중 사는 곳에서 잘 터지는 쪽을 고르세요.</p></div>
  <div class="card"><strong>고른 요금제로 바로 신청</strong><p>신청하면 본사 확인 전화(해피콜) 후 개통돼요.</p></div>
</div></div></section>

<section class="section"><div class="wrap"><h2>요금제에 붙는 혜택</h2><p class="section-lead">요금제마다 받을 수 있는 혜택이 달라요. 지급액과 조건은 신청 전에 꼭 확인하세요.</p><div class="grid cols-3">{model.benefits.map(b=><BenefitOffer benefit={b}/>)}</div></div></section>

<section class="section soft"><div class="wrap"><h2>원하는 조건으로 찾기</h2><div class="link-list">
<a href={toPublicPath("/plans/k/")}><span>K망(KT) 후불 요금제</span><span>›</span></a>
<a href={toPublicPath("/plans/l/")}><span>L망(LG U+) 후불 요금제</span><span>›</span></a>
<a href={toPublicPath("/plans/15gb/")}><span>15GB 요금제</span><span>›</span></a>
<a href={toPublicPath("/plans/price/under-30000/")}><span>3만원 이하 요금제</span><span>›</span></a>
<a href={toPublicPath("/no-contract/")}><span>무약정 후불 요금제</span><span>›</span></a>
<a href={toPublicPath("/self-phone/")}><span>자급제폰으로 가입하기</span><span>›</span></a>
</div><div class="data-note">요금 정보는 {dataDate} 기준이며, 프로모션과 혜택 조건은 가입 시점에 달라질 수 있어요.</div></div></section>
