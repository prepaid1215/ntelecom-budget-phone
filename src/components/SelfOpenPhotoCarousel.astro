---
import { toPublicPath } from "../lib/site-config.js";
import { MIRROR_KT_URL, MIRROR_LG_URL, ntgoDestination } from "../lib/ntgo-targets.js";
const kt=ntgoDestination(process.env.START_KT_URL,MIRROR_KT_URL);
const lg=ntgoDestination(process.env.START_LG_URL,MIRROR_LG_URL);
const cards=[
  {title:"셀프개통 가이드",detail:"개통 전 전체 과정을 한눈에 확인하세요.",image:"00"},
  {title:"KT·LG 통신망 선택",detail:"준비한 유심에 맞는 통신망을 선택합니다.",image:"01"},
  {title:"가입유형과 고객정보",detail:"신규가입 또는 번호이동을 선택하고 본인정보를 입력합니다.",image:"02"},
  {title:"안면인증",detail:"화면 안내에 따라 안면인증을 진행합니다.",image:"03"},
  {title:"간편 본인인증",detail:"안내된 인증수단으로 본인확인을 진행합니다.",image:"04"},
  {title:"유심번호 입력",detail:"KT는 F를 제외한 19자리, LG는 모델코드와 일련번호를 확인합니다.",image:"05"}
];
---
<div class="go-guide" data-guide-carousel>
  <div class="go-guide-heading">
    <div><span>PHOTO GUIDE</span><h3>사진으로 보는 셀프개통 가이드</h3><p>화살표나 손가락으로 넘기면서 실제 신청 화면을 확인하세요.</p></div>
  </div>
  <div class="go-guide-stage">
  <div class="go-guide-track" data-track aria-label="셀프개통 사진 안내" tabindex="0">
    {cards.map((card,i)=><article class="go-guide-slide" aria-label={(i+1)+"번째 카드, "+card.title}>
      <div class="go-guide-top"><span>{String(i+1).padStart(2,"0")} / 07</span><strong>{card.title}</strong></div>
      <a class="go-guide-photo" href={toPublicPath("/images/guide/step-"+card.image+".jpg")} target="_blank" rel="noopener noreferrer" aria-label={card.title+" 원본 사진 확대"}>
        <img src={toPublicPath("/images/guide/step-"+card.image+".jpg")} width="1080" height="1080" loading="lazy" decoding="async" alt={card.title+": 실제 신청 화면 안내 이미지"} />
      </a>
      <p>{card.detail}</p>
    </article>)}
    <article class="go-guide-slide go-guide-final" aria-label="7번째 카드, 개통 시작">
      <div class="go-guide-top"><span>07 / 07</span><strong>이제 개통을 시작하세요</strong></div>
      <div class="go-guide-final-body">
        <span class="go-guide-check" aria-hidden="true">✓</span>
        <h4>준비가 끝났다면<br/>원하는 통신망을 선택하세요.</h4>
        <p>신청 화면에서 요금제와 매월 요금 납부정보를 입력합니다. 아래 버튼을 누르면 이 판매점의 앤텔레콤 신청 화면으로 바로 연결됩니다.</p>
        <div class="go-guide-actions">
          <a href={kt} data-outbound data-billing="postpaid" data-network="kt" data-location="guide_carousel_last">KT 개통하기</a>
          <a href={lg} data-outbound data-billing="postpaid" data-network="lg" data-location="guide_carousel_last">LG 개통하기</a>
        </div>
      </div>
    </article>
  </div>
  <nav class="go-guide-nav" aria-label="사진 카드 넘기기">
    <button type="button" class="go-guide-prev" data-prev aria-label="이전 개통 안내" disabled>
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
    </button>
    <button type="button" class="go-guide-next" data-next aria-label="다음 개통 안내">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
    </button>
  </nav>
  </div>
  <div class="go-guide-footer"><span data-count aria-live="polite">1 / 7</span><span>사진을 누르면 크게 볼 수 있습니다.</span></div>
</div>
<script>
  document.querySelectorAll('[data-guide-carousel]').forEach(root=>{
    const track=root.querySelector('[data-track]');
    const slides=[...root.querySelectorAll('.go-guide-slide')];
    const count=root.querySelector('[data-count]');
    const getIndex=()=>{
      const width=slides[0]?.getBoundingClientRect().width||1;
      return Math.max(0,Math.min(slides.length-1,Math.round(track.scrollLeft/width)));
    };
    const prev=root.querySelector('[data-prev]');
    const next=root.querySelector('[data-next]');
    const updateControls=()=>{
      const i=getIndex();
      count.textContent=(i+1)+' / '+slides.length;
      prev.disabled=i===0;
      next.disabled=i===slides.length-1;
    };
    const go=n=>{
      const i=Math.max(0,Math.min(slides.length-1,n));
      track.scrollTo({left:i*track.clientWidth,behavior:'smooth'});
    };
    prev.addEventListener('click',()=>go(getIndex()-1));
    next.addEventListener('click',()=>go(getIndex()+1));
    let frame=0;
    track.addEventListener('scroll',()=>{
      cancelAnimationFrame(frame);
      frame=requestAnimationFrame(updateControls);
    },{passive:true});
    updateControls();
    window.addEventListener('resize',updateControls,{passive:true});
    track.addEventListener('keydown',event=>{
      if(event.key==='ArrowRight'){event.preventDefault();go(getIndex()+1);}
      if(event.key==='ArrowLeft'){event.preventDefault();go(getIndex()-1);}
    });
  });
</script>
<style>
  .go-guide{max-width:960px;margin:34px auto 0;color:#34323A;min-width:0}
  .go-guide-heading{display:flex;justify-content:space-between;align-items:center;gap:18px;margin-bottom:15px}
  .go-guide-stage{position:relative;min-width:0}
  .go-guide-heading span{font-size:12px;letter-spacing:.07em;font-weight:800;color:#ED2675}
  .go-guide-heading h3{font-size:clamp(22px,2.5vw,28px);margin:6px 0 3px;word-break:keep-all}
  .go-guide-heading p{margin:0;font-size:13px;color:#67616B;line-height:1.6}
  /* Arrows sit beside the image, not in the top-right heading. */
  .go-guide-nav{position:absolute;inset:0;z-index:3;pointer-events:none}
  .go-guide-nav button{position:absolute;top:50%;transform:translateY(-50%);display:grid;place-items:center;width:50px;height:50px;padding:0;border:2px solid #ED2675;background:#FFFFFFF2;border-radius:50%;color:#ED2675;cursor:pointer;pointer-events:auto;box-shadow:0 5px 16px #34323A16}
  .go-guide-nav .go-guide-prev{left:max(10px,calc(50% - 338px))}
  .go-guide-nav .go-guide-next{right:max(10px,calc(50% - 338px))}
  .go-guide-nav button svg{width:25px;height:25px;fill:none;stroke:currentColor;stroke-width:2.5;stroke-linecap:round;stroke-linejoin:round}
  .go-guide-nav button:hover,.go-guide-nav button:focus-visible{background:#ED2675;color:#FFF}
  .go-guide-nav button:focus-visible{outline:3px solid #34323A;outline-offset:3px}
  .go-guide-nav button:disabled{opacity:.3;cursor:not-allowed;border-color:#FF88B0;color:#A75B78;box-shadow:none}
  .go-guide-nav button:disabled:hover{background:#FFFFFFF2;color:#A75B78}
  .go-guide-track{display:flex;scroll-snap-type:x mandatory;overflow-x:auto;overscroll-behavior-inline:contain;scroll-behavior:smooth;scrollbar-width:none;border-radius:22px}
  .go-guide-track::-webkit-scrollbar{display:none}
  .go-guide-slide{flex:0 0 100%;min-width:0;scroll-snap-align:start;box-sizing:border-box;background:#FFF1F6;padding:15px;border:1px solid #F3D5E0;border-radius:22px}
  .go-guide-top{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:12px;font-size:15px}
  .go-guide-top span{color:#ED2675;font-weight:800;font-size:12px}
  .go-guide-top strong{font-weight:800}
  .go-guide-photo{display:block;max-width:540px;margin:0 auto}
  .go-guide-photo img{display:block;width:100%;height:auto;aspect-ratio:1;object-fit:contain;border-radius:14px;background:#fff}
  .go-guide-slide>p{max-width:540px;margin:12px auto 0;text-align:center;line-height:1.7;font-size:14px}
  .go-guide-final{display:flex;flex-direction:column}
  .go-guide-final-body{min-height:480px;max-width:580px;margin:auto;display:flex;flex-direction:column;justify-content:center;align-items:center;text-align:center;gap:16px;padding:12px}
  .go-guide-check{width:72px;height:72px;display:grid;place-items:center;border-radius:50%;background:#ED2675;color:#fff;font-size:34px}
  .go-guide-final-body h4{font-size:clamp(23px,3vw,32px);line-height:1.45;margin:0;word-break:keep-all}
  .go-guide-final-body p{color:#625B66;line-height:1.7;margin:0;font-size:14px}
  .go-guide-actions{display:flex;gap:10px;width:100%;margin-top:12px}
  .go-guide-actions a{flex:1;border-radius:13px;min-height:55px;padding:12px 8px;box-sizing:border-box;display:grid;place-items:center;text-align:center;font-weight:800;text-decoration:none;background:#ED2675;color:white}
  .go-guide-actions a:last-child{background:#FF88B0;color:#34323A}
  .go-guide-actions a:hover,.go-guide-actions a:focus-visible{filter:brightness(.95)}
  .go-guide-footer{display:flex;justify-content:space-between;gap:8px;font-size:12px;color:#716975;margin-top:9px}
  .go-guide-footer [data-count]{font-weight:850;color:#ED2675}
  @media(max-width:550px){
    .go-guide-heading{align-items:flex-start}
    .go-guide-heading h3{font-size:22px}
    .go-guide-slide{padding:9px}
    .go-guide-nav button{width:40px;height:40px;background:#FFFFFFE8;box-shadow:0 3px 8px #34323A17}
    .go-guide-nav button svg{width:22px;height:22px}
    .go-guide-nav .go-guide-prev{left:5px}
    .go-guide-nav .go-guide-next{right:5px}
    .go-guide-final-body{min-height:340px}
    .go-guide-actions{flex-direction:column}
    .go-guide-actions a{min-height:51px}
  }
</style>
