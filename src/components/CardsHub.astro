---
import { siteConfig as site, activationLink, toPublicPath } from "../lib/site-config.js";
import { plans, cards, benefits } from "../lib/catalog.js";
const { model }=Astro.props;

const won=n=>n.toLocaleString("ko-KR")+"원";
const man=n=>Math.round(n/10000)+"만원";
const checked=cards.map(c=>c.checked_at).filter(Boolean).sort().pop() || site.dataCheckedAt;
const [yy,mm,dd]=checked.split("-").map(Number);
const dataDate=`${yy}년 ${mm}월 ${dd}일`;

const cardByNetwork={K:cards.find(c=>c.eligible_networks.includes("K")),L:cards.find(c=>c.eligible_networks.includes("L"))};
const baseMax=c=>Math.max(...c.discount_tiers.map(t=>t.monthly_discount));
const cardPath={"card-kt-my-alttel-bc-baro":"/card/kt-my-alttle-bc-baro/","card-uplus-mvno-partners-samsung":"/card/uplus-partners-samsung/"};
const firstTier=c=>c.discount_tiers[0];
const payback=c=>Math.ceil((c.annual_fee||0)/firstTier(c).monthly_discount);

const benefitAmounts={"benefit-coupang-cash":5000,"benefit-naverpay":5000,"benefit-daiso":5000,"benefit-millie":11900,"benefit-oliveyoung":5000,"benefit-cu":5000};
const calcPlans=[...plans].sort((a,b)=>a.network.localeCompare(b.network) || a.monthly_price-b.monthly_price || a.name.localeCompare(b.name,"ko"))
  .map(p=>{
    const benefitId=(p.benefit_ids||[])[0];
    const benefit=benefits.find(b=>b.id===benefitId);
    return {id:p.id,network:p.network,name:p.name.replace(/^앤텔레콤\s+/,""),price:p.monthly_price,benefit:benefit ? {id:benefit.id,name:benefit.name,amount:benefitAmounts[benefit.id]||0} : null};
  });
const calcCards=Object.fromEntries(Object.entries(cardByNetwork).map(([n,c])=>[n,{name:c.name,fee:c.annual_fee||0,tiers:c.discount_tiers.map(t=>({spend:t.monthly_spend,off:t.monthly_discount}))}]));
const defaultId="ntelecom-k-7gb-cu";

const pick=(net,pred)=>plans.filter(p=>p.network===net && pred(p)).sort((a,b)=>a.monthly_price-b.monthly_price)[0];
const samples=[
  pick("L",p=>p.data_gb===7 && !p.daily_data_gb),
  pick("K",p=>p.data_gb===7 && !p.daily_data_gb),
  pick("K",p=>p.data_gb===15 && !p.daily_data_gb && p.calls.startsWith("기본제공")),
  pick("K",p=>p.data_gb===100)
].filter(Boolean);
const tierLabels=[0,1,2].map(i=>cardByNetwork.L.discount_tiers[i]);
const offAt=(c,spend)=>{ const t=[...c.discount_tiers].reverse().find(x=>spend>=x.monthly_spend); return t ? t.monthly_discount : 0; };
---
<section class="section"><div class="wrap">
  <h2>앤텔레콤에 쓸 수 있는 카드 2장</h2>
  <p class="section-lead">카드는 요금제의 망에 맞춰 골라요. K망은 BC 바로카드, L망은 삼성카드가 적용돼요.</p>
  <div class="ch-grid">{[cardByNetwork.K,cardByNetwork.L].map(c=>
    <article class="ch-card">
      <div class="ch-head"><span class="ch-net">{c.eligible_networks[0]}망</span><div><strong>{c.name}</strong><em>{c.card_company} · 연회비 {won(c.annual_fee)}</em></div></div>
      <div class="ch-max"><small>월 최대 할인</small><strong>{won(c.max_monthly_discount)}</strong>{c.max_monthly_discount>baseMax(c) && <span>생활요금 자동납부 포함 시</span>}</div>
      <div class="tier-table">{c.discount_tiers.map(t=><div class="tier-row"><span>전월 {man(t.monthly_spend)} 이상</span><strong>{won(t.monthly_discount)} 할인</strong></div>)}</div>
      <p class="ch-fee">연회비 {won(c.annual_fee)}은 첫 구간 할인만 받아도 <b>{payback(c)}개월</b>이면 회수돼요.</p>
      <div class="ch-actions"><a class="btn-secondary" href={toPublicPath(cardPath[c.id])}>카드 자세히 보기</a><a class="btn-secondary" href={c.application_url} target="_blank" rel="noopener noreferrer">카드사에서 신청</a></div>
    </article>)}
  </div>
</div></section>

<section class="section soft"><div class="wrap">
  <h2>내 요금, 카드 쓰면 얼마?</h2>
  <p class="section-lead">요금제와 한 달 카드 사용액을 고르면 실제 납부액과 생활혜택을 모두 썼을 때의 체감 비용을 함께 보여드려요.</p>
  <div class="calc" id="card-calc" data-plans={JSON.stringify(calcPlans)} data-cards={JSON.stringify(calcCards)}>
    <label class="calc-label" for="calc-plan">요금제</label>
    <select id="calc-plan" class="calc-select">{["K","L"].map(n=><optgroup label={n==="K" ? "K망 (KT망)" : "L망 (LG U+망)"}>{calcPlans.filter(p=>p.network===n).map(p=><option value={p.id} selected={p.id===defaultId}>{p.name} · {won(p.price)}</option>)}</optgroup>)}</select>
    <span class="calc-label">한 달 카드 사용액</span>
    <div class="calc-chips" role="group" aria-label="한 달 카드 사용액">{[0,30,50,70,100,120].map(v=><button type="button" class:list={["calc-chip",{"is-on":v===70}]} data-spend={v*10000}>{v===0 ? "안 씀" : v+"만원"}</button>)}</div>
    <div class="calc-result" aria-live="polite">
      <div class="calc-main"><small id="calc-card">-</small><strong id="calc-pay">-</strong><span id="calc-off">-</span></div>
      <dl>
        <div><dt>카드 없이 12개월</dt><dd id="calc-base12">-</dd></div>
        <div><dt>카드 쓰면 12개월</dt><dd id="calc-card12">-</dd></div>
        <div class="calc-save"><dt>연회비 빼고 1년 절약</dt><dd id="calc-save">-</dd></div>
        <div id="calc-benefit-row"><dt>생활혜택 가치</dt><dd id="calc-benefit">-</dd></div>
        <div class="calc-feel"><dt>혜택 반영 체감 비용</dt><dd id="calc-feel">-</dd></div>
      </dl>
      <p class="calc-feel-note" id="calc-feel-note"></p>
    </div>
    <p class="pd-note">‘월 납부액’은 카드 할인 후 실제 통신요금이고, ‘체감 비용’은 생활혜택을 모두 사용했다고 가정한 비교값이에요. 전월 카드 실적과 통신요금 자동납부 조건을 채웠을 때 기준이며 카드 연회비는 별도예요.</p>
  </div>
</div></section>

<section class="section"><div class="wrap">
  <h2>대표 요금제로 보면</h2>
  <p class="section-lead">카드 할인을 받으면 월 납부액이 이렇게 내려가요.</p>
  <div class="ch-table-wrap"><table class="ch-table">
    <thead><tr><th>요금제</th><th>기본료</th><th>전월 30만원</th><th>전월 70만원</th><th>최대 구간</th></tr></thead>
    <tbody>{samples.map(p=>{ const c=cardByNetwork[p.network]; const top=c.discount_tiers[c.discount_tiers.length-1]; return <tr>
      <th scope="row"><a href={toPublicPath(`/plans/${p.network.toLowerCase()}/item/${p.id.replace(/^ntelecom-[kl]-/,"")}/`)}>{p.name.replace(/^앤텔레콤\s+/,"")}</a><small>{p.network}망 · {c.name}</small></th>
      <td>{won(p.monthly_price)}</td>
      <td>{won(Math.max(0,p.monthly_price-offAt(c,300000)))}</td>
      <td>{won(Math.max(0,p.monthly_price-offAt(c,700000)))}</td>
      <td><b>{won(Math.max(0,p.monthly_price-top.monthly_discount))}</b><small>전월 {man(top.monthly_spend)}</small></td>
    </tr>; })}</tbody>
  </table></div>
  <p class="pd-note">연회비 {won(cardByNetwork.K.annual_fee)}은 별도예요. 표의 금액은 기본 할인만 반영한 값이에요.</p>
</div></section>

<section class="section soft"><div class="wrap">
  <h2>만들기 전에 알아둘 점</h2>
  <div class="bh-notes">
    <article><strong>망이 맞아야 해요</strong><p>K망 요금제는 {cardByNetwork.K.name}, L망 요금제는 {cardByNetwork.L.name}만 적용돼요. 다른 망의 카드는 그 회선에 적용되지 않아요.</p></article>
    <article><strong>자동이체는 앤텔레콤으로</strong><p>통신요금 자동납부는 앤텔레콤을 통해 카드로 등록해야 해요. 카드사에 요금이 청구되는 시점부터 할인이 적용돼요.</p></article>
    <article><strong>실적 구간별 할인이에요</strong><p>전월 {man(firstTier(cardByNetwork.K).monthly_spend)}을 채우지 못하면 할인이 없어요. 평소 카드 사용액이 어느 구간인지 먼저 확인하세요.</p></article>
    <article><strong>삼성카드는 생활요금도 챙겨요</strong><p>아파트관리비·보험·렌탈 같은 생활요금을 정기결제하면 1건당 1,000원, 최대 3,000원이 더 할인돼요.</p></article>
  </div>
  <p class="pd-note">카드 조건은 {dataDate} 기준이에요. 혜택은 카드사 사정에 따라 바뀔 수 있으니 발급 전에 카드사 안내를 다시 확인하세요.</p>
</div></section>

<section class="section"><div class="wrap">
  <h2>카드 할인까지 반영해서 요금제 고르기</h2>
  <div class="link-list">
    <a href={toPublicPath("/plans/k/")}><span>K망 요금제 {plans.filter(p=>p.network==="K").length}개 보기 ({cardByNetwork.K.name})</span><span>›</span></a>
    <a href={toPublicPath("/plans/l/")}><span>L망 요금제 {plans.filter(p=>p.network==="L").length}개 보기 ({cardByNetwork.L.name})</span><span>›</span></a>
    <a href={toPublicPath("/card/compare/")}><span>두 카드 실적·할인액 나란히 비교</span><span>›</span></a>
    <a href={toPublicPath("/benefits/")}><span>혜택이 붙는 요금제 모아보기</span><span>›</span></a>
  </div>
</div></section>

<section class="section soft"><div class="wrap">
  <h2>신청부터 개통까지</h2>
  <p class="section-lead">준비물은 딱 2개예요. <b>편의점 유심</b>과 <b>간편인증서 1가지</b>면 돼요.</p>
  <div class="steps">
    <article class="step"><span>1</span><div><strong>유심 구매</strong><p>K망은 바로유심(8982로 시작하는 19자리)을 CU, GS25, 이마트24에서, L망은 원칩 유심을 이마트24·배민 B마트·스토리웨이에서 구매하세요. 다이소 유심은 L망에서 쓸 수 있어요.</p></div></article>
    <article class="step"><span>2</span><div><strong>신청 페이지 접속</strong><p>‘신청하기’를 눌러 개통 페이지로 이동한 뒤 요금제를 고르고 안면인증·간편인증으로 본인 확인을 진행해요.</p></div></article>
    <article class="step"><span>3</span><div><strong>유심번호 입력 후 신청</strong><p>K망은 19자리 숫자를, L망은 유심의 모델명과 모델번호(숫자 8자리)를 입력해요. 예: K3600 + 12345678</p></div></article>
    <article class="step"><span>4</span><div><strong>해피콜 받고 개통</strong><p>신청만으로는 개통되지 않아요. 본사 확인 전화(해피콜)를 받아야 개통이 완료돼요. 개통 후 통신요금 자동납부를 카드로 등록하면 할인이 시작돼요.</p></div></article>
  </div>
  <p class="pd-note">막히는 부분이 있으면 <a href={site.business.kakao} rel="noopener">카카오톡 채널</a> 또는 {site.business.phone}으로 바로 문의하세요. 운영시간: {site.business.hours}</p>
</div></section>

<section class="section"><div class="wrap"><h2>자주 묻는 질문</h2><div class="faq-list">{model.faqs.map(f=><details class="faq"><summary>{f.q}</summary><p>{f.a}</p></details>)}</div></div></section>

<section class="section soft"><div class="wrap final-box"><h2>카드 할인까지 챙겨서 시작하세요</h2><p>신청 후 해피콜을 받으면 개통이 완료돼요.</p><a class="final-button" href={activationLink("final")}>바로 신청하기</a></div></section>

<script is:inline>
(function(){
  var root=document.getElementById("card-calc"); if(!root) return;
  var plans=JSON.parse(root.dataset.plans), cards=JSON.parse(root.dataset.cards);
  var sel=document.getElementById("calc-plan"), chips=root.querySelectorAll(".calc-chip");
  var spend=700000;
  var fmt=function(n){return n.toLocaleString("ko-KR")+"원";};
  function off(card,s){var o=0;card.tiers.forEach(function(t){if(s>=t.spend)o=t.off;});return o;}
  function render(){
    var p=plans.filter(function(x){return x.id===sel.value;})[0]; if(!p) return;
    var c=cards[p.network], d=off(c,spend), pay=Math.max(0,p.price-d);
    var benefit=p.benefit, benefitAmount=benefit ? benefit.amount : 0, feel=Math.max(0,pay-benefitAmount);
    var base12=p.price*12, card12=pay*12, save=base12-card12-(d>0?c.fee:0);
    document.getElementById("calc-card").textContent=c.name;
    document.getElementById("calc-pay").textContent="월 "+fmt(pay);
    document.getElementById("calc-off").textContent=d>0 ? "기본료 "+fmt(p.price)+" − 카드 할인 "+fmt(d) : "전월 실적 "+Math.round(c.tiers[0].spend/10000)+"만원부터 할인돼요";
    document.getElementById("calc-base12").textContent=fmt(base12);
    document.getElementById("calc-card12").textContent=fmt(card12);
    document.getElementById("calc-save").textContent=d>0 ? (save>0 ? fmt(save) : "연회비가 더 커요") : "-";
    var benefitRow=document.getElementById("calc-benefit-row"), benefitEl=document.getElementById("calc-benefit"), feelEl=document.getElementById("calc-feel"), noteEl=document.getElementById("calc-feel-note");
    benefitRow.hidden=!benefit;
    feelEl.textContent=benefit ? fmt(feel)+" 상당" : fmt(pay);
    if(!benefit){benefitEl.textContent="-";noteEl.textContent="생활혜택이 없는 요금제는 카드 할인 후 납부액과 체감 비용이 같아요.";return;}
    benefitEl.textContent=benefit.name+" −"+fmt(benefitAmount)+(benefit.id==="benefit-cu" ? " (최대)" : " 상당");
    var prefix="실제 통신요금 청구액은 월 "+fmt(pay)+"이에요. ";
    if(benefit.id==="benefit-cu") noteEl.textContent=prefix+"포켓CU 인증 후 할인 대상 품목을 월 25,000원 이상 결제해 최대 5,000원을 모두 할인받았을 때의 체감 비용이에요.";
    else if(benefit.id==="benefit-millie") noteEl.textContent=prefix+"기존에 밀리의서재 월 구독료를 지출하던 사람이 제휴 구독을 활성화해 이용할 때의 체감 비용이에요.";
    else noteEl.textContent=prefix+"사용일수 30일과 31일차 요금제 유지 조건을 채우고, 매월 받은 혜택을 기한 안에 모두 사용했을 때의 체감 비용이에요.";
  }
  sel.addEventListener("change",render);
  chips.forEach(function(b){b.addEventListener("click",function(){chips.forEach(function(x){x.classList.remove("is-on");});b.classList.add("is-on");spend=Number(b.dataset.spend);render();});});
  render();
})();
</script>
