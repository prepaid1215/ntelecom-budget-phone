---
import guides from '../data/a-postpaid-landings.json';
import {plans} from '../lib/catalog.js';
import PlanCard from './PlanCard.astro';
import {activationLink,toPublicPath} from '../lib/site-config.js';
const {page}=Astro.props;
const source='exp_a_'+page.id.replaceAll('-','_');
const start=activationLink(source,{network:page.network});
const browse=page.id==='usim'?'/start/?from='+source+'#start-usim':page.id==='benefits'?'/benefits/':page.id==='card'?'/card/':page.network?'/plans/'+page.network.toLowerCase()+'/':'/plans/';
const related=guides.filter(p=>p.id!==page.id);
const selected=plans.filter(p=>!page.network||p.network===page.network).sort((a,b)=>a.monthly_price-b.monthly_price);
const featured=selected.filter((p,i,all)=>all.findIndex(x=>x.network===p.network&&x.data_gb===p.data_gb)===i).slice(0,3);
const showPlans=!['card','usim','benefits'].includes(page.id);
---
<div class="ag" data-a-guide={page.id}>
 <div class="ag-shell">
  <nav class="ag-crumbs" aria-label="현재 위치"><a href={toPublicPath('/')}>홈</a><span>›</span><a href={toPublicPath('/guides/')}>알뜰폰 가이드</a><span>›</span><span>{page.title.split('｜')[0]}</span></nav>
  <article class="ag-article">
   <header class="ag-hero">
    <p class="ag-label">앤텔레콤 · 후불 알뜰폰</p><h1>{page.title}</h1><p class="ag-lead">{page.lead}</p>
    <div class="ag-actions"><a class="ag-primary" href={toPublicPath(browse)}>{page.cta}</a><a class="ag-secondary" href={start}>{page.network?page.network==='K'?'KT 개통 안내':'LG 개통 안내':'온라인 개통 안내'}</a></div>
    <div class="ag-highlights"><span>KT망·LG망 선택</span><span>신규가입·번호이동</span><span>온라인 가입 신청</span></div>
   </header>
   <nav class="ag-toc" aria-label="이 글의 목차"><strong>필요한 내용 바로 보기</strong>{page.sections.map((s,i)=><a href={'#guide-'+(i+1)}>{String(i+1).padStart(2,'0')}　{s.heading}</a>)}</nav>
   {page.sections.map((s,i)=><section class="ag-section" id={'guide-'+(i+1)}><span class="ag-number">{String(i+1).padStart(2,'0')}</span><h2>{s.heading}</h2>{s.paragraphs.map(p=><p>{p}</p>)}{i===1&&<a class="ag-inline" href={toPublicPath(browse)}>{page.cta} <span aria-hidden="true">→</span></a>}</section>)}
   {showPlans&&<section class="ag-section" id="guide-plans"><h2>{page.network?(page.network==='K'?'KT망':'LG망')+' 요금제 살펴보기':'월요금과 제공량 비교하기'}</h2><p>사이트에 등록된 상품입니다. 신청 전 상품 상세에서 가입 조건을 확인하세요.</p><div class="ag-plans">{featured.map(plan=><PlanCard plan={plan} slot={source}/>)}</div><a class="ag-inline" href={toPublicPath(browse)}>전체 요금제 보기 →</a></section>}
   <section class="ag-section" id="guide-faq"><h2>자주 묻는 질문</h2>{page.faq.map(f=><details class="ag-faq"><summary>{f.q}</summary><p>{f.a}</p></details>)}</section>
   <section class="ag-closing"><h2>{page.id==='card'?'할인 조건을 확인했다면 요금제를 선택하세요':page.id==='benefits'?'원하는 혜택의 요금제를 골라보세요':'준비됐다면 원하는 요금제로 시작하세요'}</h2><p>상품을 비교하고, 선택한 통신망의 가입 안내를 확인하세요.</p><div class="ag-actions"><a class="ag-primary" href={toPublicPath(browse)}>{page.cta}</a><a class="ag-secondary" href={start}>개통 안내로 이동</a></div></section>
  </article>
  <section class="ag-related"><h2>함께 확인할 안내</h2><div>{related.map(p=><a href={toPublicPath(p.path)}>{p.title}<span aria-hidden="true">›</span></a>)}</div></section>
 </div>
</div>
<style>
.ag{background:#fbf9fc;padding:30px 24px 90px}.ag-shell{max-width:960px;margin:auto}.ag-crumbs{display:flex;gap:10px;flex-wrap:wrap;font-size:13px;color:#777;margin-bottom:20px}.ag-article{background:#fff;border:1px solid #eee5ed;border-radius:24px;overflow:hidden}.ag-hero{padding:48px;background:linear-gradient(130deg,#fff0f6,#f6f1ff)}.ag-label{font-size:13px;color:#a8295d;font-weight:700;margin:0 0 15px}.ag h1{font-size:clamp(27px,3.5vw,40px);line-height:1.4;letter-spacing:-1.2px;margin:0 0 20px;word-break:keep-all}.ag-lead{font-size:17px;line-height:1.9;color:#555}.ag-actions{display:flex;flex-wrap:wrap;gap:12px;margin-top:25px}.ag-primary,.ag-secondary{display:inline-flex;align-items:center;justify-content:center;padding:15px 22px;border-radius:12px;font-weight:700;text-decoration:none}.ag-primary{background:#b91f60;color:#fff}.ag-secondary{background:#fff;color:#6c3997;border:1px solid #d9c8e5}.ag-highlights{display:flex;gap:9px;flex-wrap:wrap;margin-top:26px}.ag-highlights span{background:#fff9;border-radius:30px;padding:6px 12px;font-size:12px;color:#6a4766}.ag-toc{margin:32px 48px;padding:24px;border:1px solid #eee6f1;border-radius:16px;display:grid;gap:13px;background:#fcfaff}.ag-toc strong{margin-bottom:5px}.ag-toc a{font-size:14px;color:#60456e}.ag-section{padding:32px 48px;border-top:1px solid #f0eaf0;scroll-margin-top:110px}.ag-number{font-size:13px;font-weight:800;color:#b91f60}.ag h2{font-size:24px;line-height:1.5;letter-spacing:-.7px;margin:9px 0 20px;word-break:keep-all}.ag-section>p,.ag-faq p{font-size:16px;line-height:1.95;color:#48434c;margin:0 0 17px;word-break:keep-all}.ag-inline{display:inline-flex;gap:20px;font-weight:700;color:#a42357;margin:8px 0;text-decoration:underline;text-underline-offset:5px}.ag-plans{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;margin:24px 0}.ag-plans :global(.card){min-width:0}.ag-faq{border-top:1px solid #eee;padding:20px 0}.ag-faq summary{cursor:pointer;font-weight:700;line-height:1.7}.ag-faq p{margin:14px 0 0}.ag-closing{padding:36px 48px;background:#fff0f6}.ag-closing p{line-height:1.8;color:#655564}.ag-related{margin-top:36px}.ag-related>div{display:grid;grid-template-columns:1fr 1fr;gap:12px}.ag-related a{display:flex;gap:15px;justify-content:space-between;border:1px solid #eadfeb;background:#fff;padding:20px;border-radius:14px;font-size:14px;line-height:1.6}.ag a:focus-visible,.ag summary:focus-visible{outline:3px solid #7258e9;outline-offset:5px}@media(min-width:1101px){.ag{padding-right:244px}}@media(max-width:700px){.ag{padding:18px 14px 80px}.ag-hero{padding:28px 22px}.ag-toc{margin:24px 20px;padding:20px}.ag-section,.ag-closing{padding:28px 22px}.ag h2{font-size:21px}.ag-plans,.ag-related>div{grid-template-columns:1fr}.ag-actions{flex-direction:column}.ag-actions a{width:100%}.ag-lead{font-size:16px}}
</style>
