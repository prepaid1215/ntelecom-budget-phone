---
import {toPublicPath} from "../lib/site-config.js";
const {featured,targets}=Astro.props;
const won=n=>n.toLocaleString("ko-KR")+"원";
---
<nav class="sh-side-mobile" aria-label="모바일 빠른 메뉴"><a href="#start-choices">개통하기</a><a href="#postpaid-plans">맞춤요금제</a><button type="button" data-side-open aria-controls="start-sidebar" aria-expanded="false">추천<br/>요금제</button><a href="#start-faq">자주묻는질문</a><a href="#start-steps">개통 가이드</a></nav>
<button class="sh-side-backdrop" type="button" data-side-backdrop aria-label="사이드바 닫기" hidden></button>
<aside class="sh-aside" id="start-sidebar" aria-label="추천 요금제">
  <button class="sh-side-toggle" type="button" data-side-toggle data-close-icon={toPublicPath("/images/start/side_close.svg")} data-open-icon={toPublicPath("/images/start/side_open.svg")} aria-controls="start-sidebar" aria-expanded="true" aria-label="사이드바 접기"><img src={toPublicPath("/images/start/side_close.svg")} alt="" width="36" height="110"/></button>
  <div class="sh-side-frame">
    <div class="sh-side-title"><strong>앤텔레콤 개통방법</strong><img class="sh-side-title-icon" src="https://www.n-telecom.co.kr/common/img/masterpage/side_icon.svg" alt=""/><button type="button" data-side-close aria-label="사이드바 닫기">×</button></div>
    <div class="sh-side-scroll">
      <h2>추천요금제 <span aria-hidden="true"></span></h2>
      {featured.slice(0,3).map(p=><a class="source-side-plan" href={targets[p.network]} data-outbound data-billing="postpaid" data-network={p.network==="K"?"kt":"lg"} data-plan={p.id} data-location="sidebar">
        <div class="flex"><b>{p.name.replace(/^앤텔레콤\s*/,"")}</b><p>월 {won(p.monthly_price)}</p></div>
        <ul>
          <li><p>음성</p><p>{p.calls.replace(/\s*\(.*/,"")}</p></li>
          <li><p>문자</p><p>{p.sms}</p></li>
          <li><p>데이터</p><p>{p.data_gb?p.data_gb+"GB+":p.data_text}{p.after_speed&&<><br/>{p.after_speed}</>}</p></li>
        </ul>
      </a>)}
      <a class="sh-aside-more" href="#postpaid-plans">전체 요금제 보기 ›</a>
    </div>
    <div class="sh-side-help">
      <a class="sh-side-help-link" href="#start-steps">개통 가이드 <span aria-hidden="true">›</span></a>
      <a class="sh-side-help-link" href="#start-faq">자주 묻는 질문 <span aria-hidden="true">›</span></a>
      <a class="sh-side-action" href="#start-choices">개통하기</a>
    </div>
  </div>
</aside>
<script>
 const root=document.querySelector('[data-start-home]');
 if(root){
  const panel=root.querySelector('#start-sidebar');
  const toggle=root.querySelector('[data-side-toggle]');
  const opener=root.querySelector('[data-side-open]');
  const backdrop=root.querySelector('[data-side-backdrop]');
  const close=root.querySelector('[data-side-close]');
  const mobile=window.matchMedia('(max-width:820px)');
  function setOpen(open){
   root.classList.toggle('sh-side-collapsed',!open&&!mobile.matches);
   root.classList.toggle('sh-side-open',open&&mobile.matches);
   toggle?.setAttribute('aria-expanded',String(open));
   toggle?.setAttribute('aria-label',open?'사이드바 접기':'사이드바 펼치기');
   const handle=toggle?.querySelector('img');
   if(handle)handle.src=open?toggle.dataset.closeIcon:toggle.dataset.openIcon;
   opener?.setAttribute('aria-expanded',String(open&&mobile.matches));
   if(backdrop)backdrop.hidden=!(open&&mobile.matches);
   const frame=panel?.querySelector(".sh-side-frame");
   if(frame)frame.inert=!open;
  }
  toggle?.addEventListener('click',()=>setOpen(root.classList.contains('sh-side-collapsed')));
  opener?.addEventListener('click',()=>{setOpen(true);close?.focus()});
  function dismiss(){setOpen(false);opener?.focus()}
  close?.addEventListener('click',dismiss);backdrop?.addEventListener('click',dismiss);
  root.addEventListener('keydown',event=>{if(event.key==='Escape'&&mobile.matches)dismiss();
   if(event.key==='Tab'&&root.classList.contains('sh-side-open')){
    const items=[...panel.querySelectorAll('a,button')].filter(e=>e.getClientRects().length);
    const first=items[0],last=items[items.length-1];
    if(event.shiftKey&&document.activeElement===first){event.preventDefault();last?.focus()}
    else if(!event.shiftKey&&document.activeElement===last){event.preventDefault();first?.focus()}
   }
  });
  panel?.querySelectorAll('a[href^="#"]').forEach(link=>link.addEventListener('click',()=>{if(mobile.matches)dismiss()}));
  mobile.addEventListener('change',()=>setOpen(!mobile.matches));setOpen(!mobile.matches);
 }
</script>
