---
import { toPublicPath } from "../lib/site-config.js";
import { benefitGuides } from "../data/benefit-guides.js";
import { benefitBrand } from "../lib/benefit-brand.js";
const { benefit }=Astro.props;
const count=(benefit.eligible_plan_ids||[]).length;
const detail=benefitGuides[benefit.id];
const brand=benefitBrand[benefit.id];
const guide={
  "benefit-naverpay":{icon:"naverpay.svg",for:"네이버 쇼핑·예약·주문을 자주 하는 분",why:"네이버페이 포인트를 평소 결제에 자연스럽게 사용할 수 있어요."},
  "benefit-coupang-cash":{icon:"coupang-cash.svg",for:"쿠팡 주문을 꾸준히 하는 분",why:"쿠팡·쿠팡이츠에서 반복되는 생활비 결제에 활용할 수 있어요."},
  "benefit-millie":{icon:"millie.svg",for:"전자책·오디오북을 꾸준히 이용하는 분",why:"별도 구독료 없이 해당 요금제를 유지하는 동안 제휴 구독을 이용해요."},
  "benefit-daiso":{icon:"daiso.svg",for:"생활소품과 소모품을 자주 사는 분",why:"다이소몰과 사용 가능 매장에서 모바일상품권을 이용할 수 있어요."},
  "benefit-oliveyoung":{icon:"oliveyoung.svg",for:"뷰티·건강용품을 정기적으로 구매하는 분",why:"온라인몰과 일반 매장에서 모바일상품권을 사용할 수 있어요."},
  "benefit-cu":{icon:"cu.svg",for:"CU 편의점 이용이 잦은 분",why:"포켓CU 제휴 인증 후 대상 결제금액의 20%를 할인받을 수 있어요."}
}[benefit.id]||{icon:"shopping-bag.svg",for:"평소 이 브랜드를 자주 이용하는 분",why:"일상 소비와 통신비를 함께 고려할 수 있는 선택입니다."};
const benefitPath=toPublicPath(`/benefits/${benefit.id.replace("benefit-","")}/`);
---
<article class="benefit-box">
  {brand ? <div class:list={["benefit-icon","is-brand",{"is-square":brand.square}]}><img src={toPublicPath(brand.src)} width={brand.square ? 48 : 96} height={brand.square ? 48 : 28} alt={brand.alt} loading="lazy" decoding="async" /></div>
  : <div class="benefit-icon"><img src={toPublicPath(`/images/benefits/${guide.icon}`)} width="22" height="22" alt="" loading="lazy" decoding="async" /></div>}
  <div class="benefit-copy"><h3>{benefit.name}</h3><strong>{guide.for}</strong><p>{guide.why}</p></div>
  <div class="benefit-bottom"><span>결합 요금제 {count}개 · K망</span><a href={benefitPath}>{benefit.name} 혜택 보기 <b>›</b></a></div>
  {detail && <small><b>{detail.value}</b><br/>지급 조건과 이용 방법을 상세 페이지에서 확인하세요.</small>}
</article>