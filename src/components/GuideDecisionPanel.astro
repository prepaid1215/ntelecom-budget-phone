---
import {toPublicPath,activationLink} from '../lib/site-config.js';
import {plans,cards} from '../lib/catalog.js';
import {benefitBrand} from '../lib/benefit-brand.js';
import {cardImages} from '../lib/card-images.js';
const {page}=Astro.props;
const source='exp_a_'+page.id.replaceAll('-','_');
const selections=[
 {id:'ntelecom-l-7gb',for:'와이파이를 주로 써요',why:'이동 중 메신저·지도 위주'},
 {id:'ntelecom-k-7gb-millie',for:'독서 혜택도 원해요',why:'밀리의서재 제휴 상품'},
 {id:'ntelecom-l-11gb-daily2gb',for:'밖에서 데이터를 자주 써요',why:'기본 데이터와 매일 제공량 비교'}
].map(x=>({...x,plan:plans.find(p=>p.id===x.id)})).filter(x=>x.plan);
const benefitChoices=[['naverpay','네이버페이','네이버 쇼핑을 자주 해요'],['millie','밀리의서재','전자책·오디오북을 즐겨요'],['coupang-cash','쿠팡캐쉬','쿠팡 주문이 잦아요'],['cu','CU','편의점에서 자주 결제해요'],['daiso','다이소','생활용품을 자주 사요'],['oliveyoung','올리브영','뷰티·건강용품을 사요']];
const simChoices=[{net:'K',name:'KT 바로유심',src:'/images/usim/baro-usim.webp',w:560,h:699,entry:'숫자 19자리 · F 제외'},{net:'L',name:'LG 모두의 원칩',src:'/images/usim/onechip.webp',w:560,h:560,entry:'모델코드 5자리 + 일련번호 8자리'}];
---
<section class="dp" aria-label="선택에 필요한 핵심 정보">
 {page.id==='comparison'&&<><h2>평소 쓰는 방식으로 먼저 좁혀보세요</h2><div class="dp-stack" id="comparison-picks">{selections.map(x=><article><p class="dp-for">{x.for}</p><h3>{x.plan.name.replace(/^앤텔레콤\s*/,'')}</h3><p>{x.why}</p><dl><div><dt>월 기본료</dt><dd><strong>{x.plan.monthly_price.toLocaleString('ko-KR')}원</strong></dd></div><div><dt>데이터</dt><dd>{x.plan.data_text}</dd></div><div><dt>통화</dt><dd>{x.plan.calls}</dd></div></dl><a href={activationLink(source,{network:x.plan.network,plan:x.plan.id,planName:x.plan.name})}>이 상품으로 신청하기 ↗</a></article>)}</div></>}
 {page.id==='benefits'&&<><h2>자주 쓰는 혜택을 골라보세요</h2><div class="dp-grid" id="benefit-options">{benefitChoices.map(([id,name,why])=>{const brand=benefitBrand['benefit-'+id];return <a class="dp-option" href={toPublicPath('/benefits/'+id+'/')}><div class="dp-brand"><img src={toPublicPath(brand.src)} width={brand.square?48:96} height={brand.square?48:28} alt={brand.alt} loading="lazy"/></div><strong>{name}</strong><span>{why}</span><b>혜택·요금제 보기 →</b></a>})}</div></>}
 {page.id==='card'&&<><h2>신청할 통신망에 맞는 카드를 보세요</h2><div class="dp-grid" id="card-options">{cards.filter(c=>c.active).map(c=>{const pic=cardImages[c.id];const route=c.id==='card-kt-my-alttel-bc-baro'?'/card/kt-my-alttle-bc-baro/':'/card/uplus-partners-samsung/';return <a class="dp-option" href={toPublicPath(route)}>{pic&&<img class="dp-card" src={toPublicPath(pic.src)} width={pic.w} height={pic.h} alt={pic.alt} loading="lazy"/>}<span>{c.eligible_networks.includes('K')?'KT망':'LG망'}</span><strong>{c.name}</strong><span>전월 실적·자동납부·연회비</span><b>할인 조건 보기 →</b></a>})}</div><p class="dp-note">요금제 월 기본료와 카드 할인은 별개예요. 카드 조건을 채웠을 때 받을 할인을 따로 보세요.</p></>}
 {page.id==='usim'&&<><h2>제품명과 통신망을 같이 봐주세요</h2><div class="dp-grid dp-sims">{simChoices.map(x=><article><img src={toPublicPath(x.src)} width={x.w} height={x.h} alt={x.name+' 실제 포장'} loading="lazy"/><h3>{x.name}</h3><p>{x.entry}</p><a href={activationLink(source,{network:x.net})}>{x.net==='K'?'KT':'LG'}망 신규가입 ↗</a></article>)}</div></>}
 {page.id==='transfer'&&<><h2>기존 번호를 유지한 상태로 신청해요</h2><ol class="dp-timeline"><li><strong>기존 통신사는 먼저 해지하지 않기</strong><span>사용 중인 전화번호를 유지합니다.</span></li><li><strong>약정·결합할인 살펴보기</strong><span>현재 통신사의 해지 비용과 결합할인을 봅니다.</span></li><li><strong>번호이동·후불로 신청하기</strong><span>옮길 상품을 고르고 화면의 사전동의를 진행합니다.</span></li><li><strong>개통 완료 안내 후 유심 교체하기</strong><span>완료 안내를 받고 통화와 데이터를 이용해 봅니다.</span></li></ol><a class="dp-next" href={activationLink(source)}>번호이동 신청 안내로 이동 →</a></>}
</section>
<style>
.dp{padding:30px 42px;border-top:1px solid #eee5ec;border-bottom:1px solid #eee5ec}.dp h2{font-size:23px;margin:0 0 22px;line-height:1.5}.dp-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px}.dp-option,.dp-sims article,.dp-stack article{border:1px solid #eadfe8;border-radius:14px;padding:22px;background:#fff;min-width:0}.dp-option{display:flex;flex-direction:column;gap:12px;align-items:flex-start}.dp-option strong{font-size:17px;line-height:1.5}.dp-option span{font-size:14px;color:#766a7b;line-height:1.7}.dp-option b,.dp-sims a,.dp-stack a,.dp-next{font-size:14px;color:#a32258;margin-top:auto;font-weight:700}.dp-brand{height:56px;display:flex;align-items:center}.dp-brand img{max-width:100%;object-fit:contain}.dp-card{height:90px;width:auto;max-width:100%;object-fit:contain;margin-bottom:8px}.dp-sims{text-align:center;max-width:650px;margin:auto}.dp-sims img{height:180px;width:100%;object-fit:contain}.dp-sims h3{margin:16px 0 8px;font-size:17px}.dp-sims p{font-size:14px;color:#776b7a;line-height:1.7}.dp-sims a{display:block;margin-top:18px}.dp-stack{display:grid;gap:16px;scroll-margin-top:110px}.dp-stack .dp-for{font-size:14px;font-weight:700;color:#a32258;margin:0 0 8px}.dp-stack h3{font-size:20px;margin:0 0 8px}.dp-stack article>p:not(.dp-for){font-size:14px;color:#776b7a;margin:0 0 18px}.dp-stack dl{margin:0 0 18px}.dp-stack dl>div{display:grid;grid-template-columns:85px 1fr;gap:12px;font-size:15px;line-height:1.8;padding:5px 0}.dp-stack dt{color:#776b7a}.dp-stack dd{margin:0}.dp-stack dd strong{font-size:21px}.dp-stack a{display:block;border-top:1px solid #eee5ec;padding-top:16px}.dp-note{font-size:14px;color:#776b7a;line-height:1.8;margin:18px 0 0}.dp-timeline{counter-reset:step;padding:0;list-style:none;display:grid;gap:12px;margin:0 0 20px}.dp-timeline li{position:relative;padding:18px 20px 18px 58px;background:#fcf7fb;border-radius:12px}.dp-timeline li:before{counter-increment:step;content:counter(step);position:absolute;left:20px;top:19px;color:#b91f60;font-weight:800}.dp-timeline strong,.dp-timeline span{display:block;line-height:1.7}.dp-timeline strong{font-size:16px}.dp-timeline span{font-size:14px;color:#766a7b;margin-top:4px}.dp a:focus-visible{outline:3px solid #7750b7;outline-offset:4px}#benefit-options,#card-options{scroll-margin-top:110px}@media(max-width:700px){.dp{padding:26px 22px}.dp h2{font-size:21px}.dp-grid{grid-template-columns:1fr}.dp-stack dl>div{grid-template-columns:65px 1fr}.dp-option,.dp-sims article,.dp-stack article{padding:20px}}
</style>
