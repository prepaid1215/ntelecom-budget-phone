---
// Experiment B template. Region data and the evidence gate live in src/lib/seo-experiments/regions.js.
// Pages without verified local facts say so plainly and stay noindex; no local claims are invented.
import { toPublicPath } from "../../lib/site-config.js";
import ExperimentImage from "./ExperimentImage.astro";
import { renderVerifiedLocalFact } from "../../../scripts/regional-source-verifier.mjs";
const { page, byPath, emitted, attribution } = Astro.props;
const children = page.children.filter(path => emitted.has(path)).map(path => byPath.get(path));
const parent = page.parentPath ? byPath.get(page.parentPath) : null;
const otherType = page.type === "prepaid" ? { path: "/regions/mvno/", label: "알뜰폰 지역 안내" } : { path: "/regions/prepaid/", label: "선불폰 지역 안내" };
const childLabel = child => `${child.label} ${page.typeName}`;
const verified = page.indexCandidate;
---
<section class="section" data-experiment="B" data-level={page.level} data-region-code={page.code}><div class="wrap">
  {parent && <a class="xp-crumb" href={toPublicPath(parent.path)}>← {parent.level === "root" ? "전국" : parent.label}</a>}
  <p class="eyebrow">{page.level === "emd" ? "지역 상세" : "지역 목록"}</p>
  <h1>{page.h1}</h1>
  <p class="section-lead">{page.description}</p>
</div></section>

{page.level !== "emd" && (
  <section class="section soft"><div class="wrap">
    <h2>{page.level === "root" ? "시도 선택" : page.level === "sido" ? "시군구 선택" : "읍면동 선택"}</h2>
    {children.length
      ? <ul class="xp-cols">{children.map(child => <li><a href={toPublicPath(child.path)}>{childLabel(child)}</a></li>)}</ul>
      : <p>연결된 하위 지역이 없습니다.</p>}
  </div></section>
)}

{page.level === "emd" && (
  verified ? (
    <section class="section soft"><div class="wrap">
      <h2>출처가 확인된 지역 정보</h2>
      <ul>{page.gate.localEvidence.map(item => <li>{renderVerifiedLocalFact(item)} <small>(확인일 {item.checkedAt} · <a href={item.sourceUrl} rel="noopener noreferrer">{item.sourceLabel}</a>)</small></li>)}</ul>
      <h2>{page.catalogTitle}</h2>
      {page.gate.generatedContent.split("\n\n").map(paragraph => <p class="xp-p">{paragraph}</p>)}
    </div></section>
  ) : (
    <section class="section soft"><div class="wrap">
      <h2>지역 정보 검수 대기</h2>
      <p class="xp-p">이 지역의 매장, 유심 재고, 개통 사례처럼 지역에만 해당하는 정보는 출처로 확인되지 않아 싣지 않았습니다. {page.typeName} 개통 절차는 지역과 관계없이 온라인으로 같으므로 아래 전국 공통 안내를 참고하세요.</p>
    </div></section>
  )
)}

<section class="section"><div class="wrap">
  <h2>전국 공통 {page.typeName} 개통 안내</h2>
  <ExperimentImage kind={page.type === "prepaid" ? "products" : "lifestyle"} />
  <div class="link-list">
    {page.guides.map(guide => <a href={toPublicPath(guide.path)}><span>{guide.label}</span><span>›</span></a>)}
    {emitted.has(otherType.path) && <a href={toPublicPath(otherType.path)}><span>{otherType.label}</span><span>›</span></a>}
  </div>
  <p class="pd-note">{attribution}</p>
</div></section>

<style>
  .xp-crumb{display:inline-block;margin-bottom:10px;color:#61636b;font-weight:700}
  .xp-cols{columns:2;column-gap:28px;padding-left:20px}
  .xp-cols li{break-inside:avoid;padding:4px 0}
  .xp-p{line-height:1.8;color:#3d3f46}
  @media(max-width:600px){.xp-cols{columns:1}}
</style>
