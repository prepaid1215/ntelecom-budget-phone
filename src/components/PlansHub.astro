---
import { siteConfig as site, activationLink, toPublicPath } from "../lib/site-config.js";
import { plans, cards } from "../lib/catalog.js";
import HomePlanFinder from "./HomePlanFinder.astro";
const { model }=Astro.props;
const biz=site.business;
const won=n=>n.toLocaleString("ko-KR")+"원";
const shortId=p=>p.id.replace("ntelecom-k-","").replace("ntelecom-l-","");
const planPath=p=>toPublicPath(`/plans/${p.network.toLowerCase()}/item/${shortId(p)}/`);
const displayName=p=>p.name.replace(/^앤텔레콤\s+/,"");

const byId=Object.fromEntries(plans.map(p=>[p.id,p]));
const picks=[
  {label:"가볍게 시작",desc:"메신저·지도·음악 위주라면",plan:byId["ntelecom-l-7gb"]},
  {label:"가장 무난한 선택",desc:"영상도 가끔 보고 데이터를 넉넉히 쓰려면",plan:byId["ntelecom-k-15gb-millie"]},
  {label:"데이터를 많이",desc:"영상·테더링을 자주 쓴다면",plan:byId["ntelecom-l-daily5gb"]}
].filter(x=>x.plan);

const netRows=["K","L"].map(n=>{
  const list=plans.filter(p=>p.network===n);
  const card=cards.find(c=>c.active&&(c.eligible_networks||[]).includes(n));
  return {n,count:list.length,min:Math.min(...list.map(p=>p.monthly_price)),max:Math.max(...list.map(p=>p.monthly_price)),
    port:list.every(p=>p.port_available===true),benefit:list.some(p=>(p.benefit_ids||[]).length),
    card:card ? card.name : "-"};
});
const speedRows=[1,3,5].map(m=>{
  const list=plans.filter(p=>p.after_speed===m+"Mbps");
  return list.length ? {speed:m+"Mbps",count:list.length,min:Math.min(...list.map(p=>p.monthly_price))} : null;
}).filter(Boolean);
---
<div id="plans"><HomePlanFinder model={model}/></div>

<section class="section"><div class="wrap">
  <h2>어떤 걸 골라야 할지 모르겠다면</h2>
  <p class="section-lead">사용량별로 많이 찾는 요금제를 먼저 골라 놨어요.</p>
  <div class="ph-picks">{picks.map(({label,desc,plan})=>
    <a class="ph-pick" href={planPath(plan)}>
      <small>{label}</small>
      <strong>{displayName(plan)}</strong>
      <span>{desc}</span>
      <em>{plan.data_gb ? plan.data_gb+"GB" : "매일 "+plan.daily_data_gb+"GB"} · 월 {won(plan.monthly_price)}</em>
    </a>)}
  </div>
</div></section>

<section class="section soft"><div class="wrap">
  <h2>K망과 L망, 이렇게 달라요</h2>
  <div class="ch-table-wrap"><table class="ch-table gd-table">
    <thead><tr><th></th><th>K망 (KT망)</th><th>L망 (LG U+망)</th></tr></thead>
    <tbody>
      <tr><th scope="row">요금제</th>{netRows.map(r=><td><b>{r.count}개</b><small>{won(r.min)} ~ {won(r.max)}</small></td>)}</tr>
      <tr><th scope="row">번호이동</th>{netRows.map(r=><td>{r.port ? "가능" : "신청 전 문의"}</td>)}</tr>
      <tr><th scope="row">생활혜택</th>{netRows.map(r=><td>{r.benefit ? "쿠팡·네이버페이 등" : "없음"}</td>)}</tr>
      <tr><th scope="row">제휴카드</th>{netRows.map(r=><td>{r.card}</td>)}</tr>
    </tbody>
  </table></div>
  <p class="pd-note">내가 사는 곳에서 잘 터지는 망을 고르는 게 먼저예요. 번호이동이나 혜택이 필요하면 K망 요금제를 보세요.</p>
</div></section>

<section class="section"><div class="wrap">
  <h2>데이터를 다 쓴 뒤 속도</h2>
  <p class="section-lead">기본 데이터를 다 써도 요금제마다 정해진 속도로 계속 쓸 수 있어요.</p>
  <div class="cmp-table">{speedRows.map(r=>
    <div class="cmp-row"><span>최대 {r.speed}<small>{r.count}개 요금제</small></span><strong>{won(r.min)}~</strong><em></em></div>)}
  </div>
  <p class="pd-note">체감 속도는 사용 장소와 휴대폰 상태에 따라 달라질 수 있어요.</p>
</div></section>

<section class="section soft"><div class="wrap">
  <h2>더 줄이고 싶다면</h2>
  <div class="link-list">
    <a href={toPublicPath("/card/")}><span>제휴카드로 통신비 할인받기</span><span>›</span></a>
    <a href={toPublicPath("/benefits/")}><span>쿠팡·네이버페이 등 혜택 요금제</span><span>›</span></a>
    <a href={toPublicPath("/number-transfer/")}><span>번호 그대로 옮기는 번호이동</span><span>›</span></a>
    <a href={toPublicPath("/guide/")}><span>유심 구매부터 개통까지 안내</span><span>›</span></a>
  </div>
</div></section>

<section class="section"><div class="wrap"><h2>자주 묻는 질문</h2><div class="faq-list">{model.faqs.map(f=><details class="faq"><summary>{f.q}</summary><p>{f.a}</p></details>)}</div>
  <p class="pd-note">막히는 부분이 있으면 <a href={biz.kakao} rel="noopener">카카오톡 채널</a> 또는 {biz.phone}으로 문의하세요. 운영시간: {biz.hours}</p>
</div></section>

<section class="section soft"><div class="wrap final-box"><h2>요금제를 골랐다면 바로 신청하세요</h2><p>신청하면 개통돼서 바로 쓸 수 있어요. 해피콜은 꼭 받아 주세요.</p><a class="final-button" href={activationLink("final")}>바로 신청하기</a></div></section>
