{
  "name": "ntelecom-postpaid-page-factory",
  "version": "3.0.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "type": "module",
  "scripts": {
    "generate": "node scripts/generate-pages.mjs",
    "validate": "node scripts/validate-data.mjs",
    "report": "node scripts/content-report.mjs",
    "qa:mobile": "node scripts/mobile-qa.mjs",
    "dev": "pnpm run generate && astro dev",
    "build": "pnpm run generate && pnpm run validate && astro build",
    "preview": "astro preview",
    "audit:seo": "node scripts/seo-audit.mjs",
    "regions:import": "node scripts/import-regional-source.mjs",
    "regions:sync-url-lock": "node scripts/import-regional-source.mjs --sync-url-lock",
    "regions:generate": "node scripts/generate-regional-pages.mjs",
    "regions:audit": "node scripts/audit-regional-pages.mjs",
    "regions:quality-test": "node scripts/test-regional-quality.mjs",
    "regions:pipeline-test": "node scripts/test-regional-pipeline.mjs",
    "regions:sources-test": "node scripts/test-regional-sources.mjs",
    "regions:fetch-source": "node scripts/fetch-regional-source.mjs",
    "regions:content-preview": "node scripts/generate-regional-pages.mjs",
    "regions:record-observation": "node scripts/record-regional-observation.mjs",
    "seo:test": "node scripts/seo-experiments/test-all.mjs",
    "seo:test:units": "node --test scripts/seo-experiments/test-units.mjs",
    "seo:test:dist": "node --test scripts/seo-experiments/test-dist.mjs",
    "seo:test:http": "node --test scripts/seo-experiments/test-http.mjs",
    "seo:test:system": "node --test scripts/seo-experiments/test-system.mjs",
    "seo:render": "python3 scripts/seo-experiments/render-check.py",
    "seo:baseline": "node scripts/seo-experiments/compare-baseline.mjs",
    "seo:audit-diff": "node scripts/seo-experiments/audit-diff.mjs",
    "seo:a-review": "node scripts/seo-experiments/a-review.mjs",
    "seo:manifest": "node scripts/seo-experiments/link-manifest.mjs",
    "seo:indexkit": "node scripts/seo-experiments/indexkit.mjs",
    "seo:observe": "node scripts/seo-experiments/observe.mjs",
    "seo:report": "node scripts/seo-experiments/report.mjs",
    "seo:serve": "node scripts/seo-experiments/serve.mjs",
    "seo:indexnow:prepare": "node scripts/seo-experiments/indexnow-pipeline.mjs",
    "seo:indexnow:send": "node scripts/seo-experiments/indexnow-send.mjs",
    "seo:indexnow:test": "node --test scripts/seo-experiments/test-indexnow.mjs"
