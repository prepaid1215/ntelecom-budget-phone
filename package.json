{
  "name": "ntelecom-postpaid-page-factory",
  "version": "3.0.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "type": "module",
  "scripts": {
    "generate": "node scripts/generate-pages.mjs",
    "validate": "node scripts/validate-data.mjs",
    "report": "node scripts/content-report.mjs",
    "qa:mobile": "node scripts/mobile-qa.mjs",
    "dev": "pnpm run generate && astro dev",
    "build": "pnpm run generate && pnpm run validate && astro build",
    "preview": "astro preview",
    "audit:seo": "node scripts/seo-audit.mjs",
    "regions:import": "node scripts/import-regional-source.mjs",
    "regions:sync-url-lock": "node scripts/import-regional-source.mjs --sync-url-lock",
    "regions:generate": "node scripts/generate-regional-pages.mjs",
    "regions:audit": "node scripts/audit-regional-pages.mjs",
    "regions:quality-test": "node scripts/test-regional-quality.mjs",
    "regions:pipeline-test": "node scripts/test-regional-pipeline.mjs",
    "regions:sources-test": "node scripts/test-regional-sources.mjs",
    "regions:fetch-source": "node scripts/fetch-regional-source.mjs",
    "regions:content-preview": "node scripts/generate-regional-pages.mjs",
    "regions:record-observation": "node scripts/record-regional-observation.mjs"
  },
  "dependencies": {
    "astro": "^5.0.0"
  }
